# Projects

## Production Systems & Infrastructure

{% for p in projects %}
<div class="publication-card">
    <div class="publication-image">
        <lottie-player
            class="lottie-fill"
            src="{{ p.icon }}"
            background="transparent"
            speed="1"
            preserveAspectRatio="xMidYMid meet"
            loop
            autoplay>
        </lottie-player>
    </div>
    <div class="publication-content">
        <h3 class="publication-title">
{% if p.link %}
            <a href="{{ p.link }}" target="_blank" class="publication-link">
                {{ p.name }}
            </a>
{% else %}
            {{ p.name }}
{% endif %}
        </h3>
        <div class="publication-venue">{{ p.venue }}</div>
        <div class="publication-authors">{{ person.name }}</div>
        <div class="publication-year">{{ p.period }}</div>
        <div class="publication-tags">
{% for tag in p.tags %}
            <span class="tag tag-safety">{{ tag }}</span>
{% endfor %}
{% if p.link %}
            <a href="{{ p.link }}" class="tag tag-arxiv">LIVE SITE</a>
{% endif %}
        </div>
        <p style="margin-top:0.5rem;font-size:0.9rem;line-height:1.5;">
            {{ p.site_summary }}
        </p>
{% if p.site_detail %}
        <details style="margin-top:0.75rem;">
            <summary style="font-size:0.9rem;font-weight:600;cursor:pointer;color:var(--color-accent);">How it's built ▸</summary>
            <div style="margin-top:0.5rem;font-size:0.9rem;line-height:1.6;padding-left:0.5rem;border-left:2px solid var(--color-accent);margin-left:0.25rem;">
                <p>{{ p.site_detail }}</p>
            </div>
        </details>
{% endif %}
    </div>
</div>

{% endfor %}
