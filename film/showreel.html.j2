<!doctype html>
<!-- The showreel film. Rendered by scripts/make_film.py from profile/profile.yaml (site.showreel);
     every figure comes from there. The page is a 1920x1080 stage: render(t) sets every element
     for time t, so the film is captured frame by frame and every frame is exact. -->
<html lang="en-GB">
<head>
<meta charset="utf-8">
<title>Orca showreel</title>
<style>
@font-face { font-family: "Mona Sans"; font-weight: 200 900; font-stretch: 75% 125%; src: url("{{ font_url }}") format("woff2"); }
:root { --field: #0c0c0e; --ink: #f2efe9; --ink-2: #b3aea5; --ink-3: #8a857d; --line: rgb(242 239 233 / 0.12); --accent: #ff4a1c; --panel: #161618; --rule: rgb(242 239 233 / 0.11); }
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: 1920px; height: 1080px; overflow: hidden; background: var(--field); }
body { font-family: "Mona Sans", sans-serif; color: var(--ink); font-feature-settings: "ss01", "cv11"; -webkit-font-smoothing: antialiased; font-variant-numeric: tabular-nums; }
.stage { position: relative; width: 1920px; height: 1080px; overflow: hidden; }
.scene { position: absolute; inset: 0; padding: 150px 160px 140px; opacity: 0; }
.credit { font-size: 20px; font-weight: 560; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-3); }
.head { font-size: 68px; font-weight: 540; letter-spacing: -0.03em; line-height: 1.05; }
.sub { font-size: 30px; color: var(--ink-2); margin-top: 22px; max-width: 1100px; line-height: 1.4; }
.mask { display: inline-block; background: currentColor; -webkit-mask: url("{{ mark_url }}") center / contain no-repeat; mask: url("{{ mark_url }}") center / contain no-repeat; }

/* chrome */
.bar { position: absolute; top: 0; left: 0; height: 3px; width: 1920px; background: var(--accent); transform-origin: left center; z-index: 5; }
.foot { position: absolute; left: 160px; right: 160px; bottom: 56px; display: flex; justify-content: space-between; z-index: 5; }
.foot .tags { position: relative; height: 24px; width: 700px; }
.foot .tag { position: absolute; right: 0; top: 0; opacity: 0; white-space: nowrap; }

/* 1 title */
.s-title { display: grid; place-items: center; align-content: center; text-align: center; gap: 0; }
.s-title .mask { width: 132px; height: 126px; color: var(--ink); margin-bottom: 30px; }
.s-title h1 { font-size: 248px; font-weight: 560; letter-spacing: -0.045em; line-height: 0.95; font-stretch: 98%; position: relative; }
.s-title h1 span { display: inline-block; }
.s-title .u { position: absolute; left: 4px; right: 12px; bottom: -14px; height: 8px; background: var(--accent); transform-origin: left center; }
.s-title .line { font-size: 46px; color: var(--ink-2); margin-top: 58px; letter-spacing: -0.01em; }
.s-title .credit { margin-top: 34px; font-size: 22px; }

/* 2 product */
.s-product { perspective: 2200px; }
.win { position: absolute; left: 330px; top: 70px; width: 1260px; height: 892px; background: var(--panel); border: 1px solid var(--rule); border-radius: 22px; overflow: hidden; display: grid; grid-template-rows: auto 1fr auto; font-size: 23px; line-height: 1.45; transform-origin: 50% 40%; }
.win-bar { display: flex; align-items: center; gap: 16px; padding: 20px 30px; border-bottom: 1px solid var(--rule); }
.win-bar .mask { width: 32px; height: 30px; color: var(--ink); }
.win-bar b { font-weight: 560; font-size: 26px; }
.chip { font-size: 16px; font-weight: 560; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-3); border: 1px solid var(--rule); border-radius: 99px; padding: 3px 14px; }
.dots { margin-left: auto; display: flex; gap: 6px; } .dots i { width: 6px; height: 6px; border-radius: 50%; background: var(--ink-3); }
.convo { padding: 28px 44px; display: grid; gap: 18px; align-content: start; }
.you { justify-self: end; width: 80%; background: rgb(242 239 233 / 0.09); border-radius: 22px 22px 6px 22px; padding: 16px 24px; min-height: 104px; }
.steps { list-style: none; display: grid; gap: 9px; font-size: 20px; color: var(--ink-2); }
.steps li { display: flex; align-items: center; gap: 16px; }
.dot { position: relative; width: 26px; height: 26px; flex: none; }
.dot .ring { position: absolute; inset: 0; border-radius: 50%; border: 2px solid rgb(242 239 233 / 0.25); border-top-color: var(--ink); }
.dot .fill { position: absolute; inset: 0; border-radius: 50%; background: var(--ink); display: grid; place-items: center; }
.dot .fill svg { width: 15px; height: 15px; }
.reply { display: grid; gap: 14px; }
.reply p { max-width: 980px; }
table { width: 100%; border-collapse: collapse; font-size: 19px; }
th { text-align: left; font-size: 15px; font-weight: 560; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-3); padding: 0 16px 10px 0; }
td { padding: 8px 16px 8px 0; border-top: 1px solid var(--rule); color: var(--ink-2); }
th:not(:first-child), td:not(:first-child) { text-align: right; } th:last-child, td:last-child { padding-right: 0; }
td:first-child, td:last-child { color: var(--ink); }
.art { display: flex; align-items: center; gap: 18px; border: 1px solid var(--rule); border-radius: 14px; padding: 14px 18px; width: 620px; }
.thumb { width: 52px; height: 52px; border-radius: 9px; background: rgb(242 239 233 / 0.09); display: grid; place-items: center; color: var(--ink-2); }
.art .nm { font-weight: 540; } .art .mt { font-size: 18px; color: var(--ink-3); }
.open { margin-left: auto; font-size: 19px; font-weight: 540; border: 1px solid var(--rule); border-radius: 99px; padding: 6px 18px; }
.open-hot { position: absolute; inset: -1px; border-radius: 99px; border: 2px solid var(--accent); }
.stamp { font-size: 16px; font-weight: 560; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-3); }
.composer { margin: 0 28px 26px; border: 1px solid var(--rule); border-radius: 16px; padding: 14px 16px 14px 22px; display: flex; align-items: center; gap: 14px; color: var(--ink-3); }
.send { margin-left: auto; width: 40px; height: 40px; border-radius: 50%; background: var(--ink); color: var(--field); display: grid; place-items: center; }
.note { position: absolute; left: 330px; top: 980px; font-size: 20px; color: var(--ink-3); }

/* 3 loop */
.loop { position: absolute; left: 160px; right: 160px; top: 430px; display: grid; grid-template-columns: repeat({{ loop|length }}, 1fr); }
.loop .rail { position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--ink-3); transform-origin: left center; }
.loop .pulse { position: absolute; top: -9px; left: -3px; width: 20px; height: 20px; border-radius: 50%; background: var(--accent); }
.loop .step { position: relative; padding-top: 44px; }
.loop .step::before { content: ""; position: absolute; top: -6px; left: 0; width: 14px; height: 14px; border-radius: 50%; background: var(--ink); }
.loop .nm { display: block; font-size: 54px; font-weight: 540; letter-spacing: -0.03em; }
.loop .ln { display: block; font-size: 25px; color: var(--ink-2); margin-top: 12px; max-width: 280px; line-height: 1.4; }
.ret { position: absolute; left: 160px; top: 640px; width: 1600px; height: 120px; overflow: visible; }
.ret path { fill: none; stroke: var(--ink-3); stroke-width: 2; }
.loop-note { position: absolute; left: 160px; top: 800px; font-size: 34px; color: var(--ink-2); }

/* 4 capabilities */
.caps { margin-top: 90px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 70px 80px; }
.caps div { border-top: 1px solid var(--line); padding-top: 26px; }
.caps b { display: block; font-size: 64px; font-weight: 530; letter-spacing: -0.025em; }
.caps span { display: block; font-size: 25px; color: var(--ink-2); margin-top: 12px; line-height: 1.4; max-width: 470px; }

/* 5, 6, 8 sentence scenes */
.lines { margin-top: 80px; display: grid; gap: 34px; }
.lines p { font-size: 62px; font-weight: 460; letter-spacing: -0.02em; line-height: 1.15; color: var(--ink-2); }
.lines p b { font-weight: 560; color: var(--ink); }
.inst { position: absolute; left: 160px; bottom: 140px; display: flex; gap: 10px; }
.inst i { width: 26px; height: 26px; border-radius: 4px; background: var(--ink); }

/* 7 platform */
.yr { position: absolute; left: 160px; top: 330px; width: 520px; }
.yr .num { position: relative; height: 200px; }
.yr .num span { position: absolute; left: 0; top: 0; font-size: 200px; font-weight: 520; letter-spacing: -0.05em; line-height: 1; opacity: 0; }
.yr .era { position: relative; height: 60px; margin-top: 26px; }
.yr .era span { position: absolute; left: 0; top: 0; font-size: 48px; font-weight: 530; letter-spacing: -0.02em; opacity: 0; }
.yr .eline { position: relative; height: 140px; margin-top: 10px; }
.yr .eline span { position: absolute; left: 0; top: 0; font-size: 25px; color: var(--ink-2); line-height: 1.45; width: 470px; opacity: 0; }
.meas { position: absolute; left: 820px; right: 160px; top: 330px; display: grid; gap: 34px; }
.meas .row { display: grid; grid-template-columns: 1fr 190px; gap: 8px 30px; align-items: end; }
.meas .lb { font-size: 26px; color: var(--ink-2); }
.meas .vals { position: relative; height: 40px; text-align: right; }
.meas .vals span { position: absolute; right: 0; top: 0; font-size: 34px; font-weight: 540; opacity: 0; white-space: nowrap; }
.meas .vals span.none { color: var(--ink-3); font-weight: 420; font-size: 28px; top: 4px; }
.meas .track { grid-column: 1 / -1; height: 6px; background: rgb(242 239 233 / 0.08); border-radius: 3px; overflow: hidden; }
.meas .track i { display: block; height: 100%; width: 100%; background: var(--ink); transform-origin: left center; transform: scaleX(0); }

/* 9 savings */
.money { margin-top: 48px; display: grid; gap: 14px; }
.money .row { display: grid; grid-template-columns: 640px 50px 1fr; align-items: center; gap: 24px; border-top: 1px solid var(--line); padding-top: 14px; }
.money .stop { position: relative; white-space: nowrap; font-size: 40px; font-weight: 530; letter-spacing: -0.02em; justify-self: start; }
.money .strike { position: absolute; left: -6px; right: -6px; top: 54%; height: 4px; background: var(--accent); transform-origin: left center; }
.money .arrow { color: var(--ink-3); }
.money .inst2 { font-size: 34px; color: var(--ink); }
.money .amt { display: block; font-size: 21px; color: var(--ink-3); margin-top: 4px; }
.close { position: absolute; left: 160px; bottom: 112px; font-size: 56px; font-weight: 540; letter-spacing: -0.02em; }

/* 10 diagram */
.dia { position: absolute; left: 160px; top: 330px; width: 1600px; transform-origin: 50% 50%; }
.dia svg { width: 1600px; height: auto; display: block; }

/* 11 end */
.s-end { display: grid; align-content: center; justify-items: start; }
.s-end h2 { font-size: 196px; font-weight: 560; letter-spacing: -0.045em; line-height: 0.95; position: relative; }
.s-end .u { position: absolute; left: 4px; right: 8px; bottom: -16px; height: 8px; background: var(--accent); transform-origin: left center; }
.s-end .role { font-size: 46px; color: var(--ink-2); margin-top: 60px; }
.s-end .url { font-size: 46px; margin-top: 22px; font-weight: 540; }
</style>
</head>
<body>
<div class="stage">
  <div class="bar" id="bar"></div>

  <section class="scene s-title" id="s1">
    <span class="mask" id="t-mark"></span>
    <h1 id="t-h1">{% for ch in "Orca" %}<span class="t-ch">{{ ch }}</span>{% endfor %}<i class="u" id="t-u"></i></h1>
    <p class="line" id="t-line">{{ title_line }}</p>
    <p class="credit" id="t-credit">{{ film.credit }}</p>
  </section>

  <section class="scene s-product" id="s2">
    <div class="win" id="win">
      <div class="win-bar"><span class="mask"></span><b>Orca</b><span class="chip">New chat</span><span class="dots"><i></i><i></i><i></i></span></div>
      <div class="convo">
        <p class="you" id="q" data-full="{{ demo.question }}"></p>
        <ol class="steps">
          {% for s in demo.steps %}<li class="st"><span class="dot"><span class="ring"></span><span class="fill"><svg viewBox="0 0 24 24" fill="none" stroke="#0c0c0e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span></span><span>{{ s }}</span></li>{% endfor %}
        </ol>
        <div class="reply">
          <p id="ans">{{ demo.answer }}</p>
          <table id="tbl"><thead><tr>{% for h in demo.table.head %}<th>{{ h }}</th>{% endfor %}</tr></thead>
            <tbody>{% for r in demo.table.rows %}<tr class="tr">{% for c in r %}<td>{{ c }}</td>{% endfor %}</tr>{% endfor %}</tbody></table>
          <div class="art" id="art"><span class="thumb"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm8 11v4m-4 0h8"/></svg></span><span><span class="nm" style="display:block">{{ demo.artefact.name }}</span><span class="mt">{{ demo.artefact.meta }}</span></span><span class="open" style="position:relative">Open<i class="open-hot" id="hot"></i></span></div>
          <p class="stamp" id="stamp">{{ demo.stamp }}</p>
        </div>
      </div>
      <div class="composer"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg><span>Ask Orca</span><span class="send"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5m-6 6 6-6 6 6"/></svg></span></div>
    </div>
    <p class="note" id="note">{{ demo.note }}</p>
  </section>

  <section class="scene" id="s3">
    <h2 class="head sh">How it works</h2>
    <div class="loop" id="loop">
      <i class="rail" id="rail"></i><i class="pulse" id="pulse"></i>
      {% for s in loop %}<div class="step"><span class="nm">{{ s.name }}</span><span class="ln">{{ s.line }}</span></div>{% endfor %}
    </div>
    <svg class="ret" viewBox="0 0 1600 120" id="ret"><path id="ret-path" pathLength="1" d="M{{ (1600 * (loop|length - 1) / loop|length)|round|int + 6 }} 0 V70 Q{{ (1600 * (loop|length - 1) / loop|length)|round|int + 6 }} 100 {{ (1600 * (loop|length - 1) / loop|length)|round|int - 24 }} 100 H36 Q6 100 6 70 V14"/><path id="ret-head" d="M-4 26 6 12 16 26"/></svg>
    <p class="loop-note" id="loop-note">{{ loop_note }}</p>
  </section>

  <section class="scene" id="s4">
    <h2 class="head sh">What it does</h2>
    <div class="caps">{% for c in caps %}<div class="cap"><b>{{ c.name }}</b><span>{{ c.line }}</span></div>{% endfor %}</div>
  </section>

  {% for sid, title, items in [("s5", "Adoption", film.adoption), ("s6", "Running cost and footprint", film.lean), ("s8", "Scale", film.scale)] %}
  <section class="scene" id="{{ sid }}">
    <h2 class="head sh">{{ title }}</h2>
    <div class="lines">{% for l in items %}<p class="ln-{{ sid }}"><b>{% if l.count %}<span class="cnt" data-to="{{ l.count }}" data-comma="{{ 1 if l.comma else 0 }}">{{ l.num }}</span>{{ l.rest }}{% else %}{{ l.lead }}{% endif %}</b> {{ l.text }}</p>{% endfor %}</div>
    {% if sid == "s6" %}<div class="inst" id="inst">{% for i in range(30) %}<i></i>{% endfor %}</div>{% endif %}
  </section>
  {% endfor %}

  <section class="scene" id="s7">
    <h2 class="head sh">The platform</h2>
    <p class="sub sh">{{ platform.line }}</p>
    <div class="yr">
      <div class="num">{% for e in eras %}<span class="y-num">{{ e.year }}</span>{% endfor %}</div>
      <div class="era">{% for e in eras %}<span class="y-era">{{ e.name }}</span>{% endfor %}</div>
      <div class="eline">{% for e in eras %}<span class="y-line">{{ e.line }}</span>{% endfor %}</div>
    </div>
    <div class="meas">
      {% for m in measures %}<div class="row"><span class="lb">{{ m.name }}</span><span class="vals">{% for lab in m.labels %}<span class="v v{{ loop.index0 }}{% if m.values[loop.index0] is none %} none{% endif %}">{{ lab }}</span>{% endfor %}</span><span class="track"><i class="bar-{{ loop.index0 }}" data-shares="{{ m.shares|join(',') }}"></i></span></div>{% endfor %}
    </div>
  </section>

  <section class="scene" id="s9">
    <h2 class="head sh">Savings</h2>
    <div class="money">{% for m in money %}<div class="row mrow"><span class="stop">{{ m.stopped }}<i class="strike"></i></span><svg class="arrow" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg><span class="inst2">{{ m.instead }}<span class="amt">{{ m.amount }}</span></span></div>{% endfor %}</div>
    <p class="close" id="close">{{ film.close }}</p>
  </section>

  <section class="scene" id="s10">
    <h2 class="head sh">How it fits together</h2>
    <div class="dia" id="dia">{{ diagram|safe }}</div>
  </section>

  <section class="scene s-end" id="s11">
    <h2 id="e-h">{{ name }}<i class="u" id="e-u"></i></h2>
    <p class="role" id="e-role">{{ role }}</p>
    <p class="url" id="e-url">saahil.co.uk</p>
  </section>

  <div class="foot"><span class="credit" id="who">Saahil Mehta</span><span class="tags">{% for s in scenes %}<span class="credit tag" id="tag-{{ s.id }}">{{ s.tag }}</span>{% endfor %}</span></div>
</div>

<script>
const DURATION = {{ duration }};
const SCENES = {{ scenes_json|safe }};
const DIAGRAM_AT = {{ diagram_at }};
// ---- a small deterministic timeline: tweens keyed by element and property, evaluated at t
const tracks = new Map();
const E = {
  out: (t) => 1 - Math.pow(1 - t, 4),
  inout: (t) => (t < 0.5 ? 8 * t ** 4 : 1 - Math.pow(-2 * t + 2, 4) / 2),
  lin: (t) => t,
  step: (t) => (t < 1 ? 0 : 1),
};
function at(sel, start, dur, props, opt = {}) {
  const pick = (x) => (typeof x === "string" ? [...document.querySelectorAll(x)] : [x]);
  const els = (Array.isArray(sel) ? sel.flatMap(pick) : pick(sel)).filter(Boolean);
  els.forEach((el, i) => {
    const s = start + i * (opt.stagger || 0);
    let tr = tracks.get(el);
    if (!tr) tracks.set(el, (tr = {}));
    for (const [k, v] of Object.entries(props)) (tr[k] ||= []).push({ s, d: Math.max(dur, 0.0001), a: v[0], b: v[1], e: E[opt.ease || "out"] });
  });
}
const lerp = (a, b, p) => (Array.isArray(a) ? a.map((x, i) => x + (b[i] - x) * p) : a + (b - a) * p);
function value(list, t) {
  let cur = null;
  for (const tw of list) if (t >= tw.s && (!cur || tw.s >= cur.s)) cur = tw;
  if (!cur) return list.reduce((m, x) => (x.s < m.s ? x : m)).a;
  return lerp(cur.a, cur.b, cur.e(Math.min(1, (t - cur.s) / cur.d)));
}
function render(t) {
  for (const [el, tr] of tracks) {
    const v = {};
    for (const k in tr) v[k] = value(tr[k], t);
    if ("o" in v) el.style.opacity = v.o;
    const tf = [];
    if ("x" in v || "y" in v) tf.push(`translate(${v.x || 0}px, ${v.y || 0}px)`);
    if ("rx" in v) tf.push(`rotateX(${v.rx}deg)`);
    if ("r" in v) tf.push(`rotate(${v.r}deg)`);
    if ("s" in v) tf.push(`scale(${v.s})`);
    if ("sx" in v) tf.push(`scaleX(${v.sx})`);
    if (tf.length) el.style.transform = tf.join(" ");
    if ("blur" in v) el.style.filter = v.blur > 0.05 ? `blur(${v.blur}px)` : "none";
    if ("clip" in v) el.style.clipPath = `inset(${v.clip.map((c) => c + "%").join(" ")})`;
    if ("draw" in v) el.style.strokeDashoffset = v.draw;
    if ("type" in v) el.textContent = el.dataset.full.slice(0, Math.round(v.type * el.dataset.full.length));
    if ("count" in v) {
      const n = Math.round(v.count);
      el.textContent = el.dataset.comma === "1" ? n.toLocaleString("en-GB") : String(n);
    }
  }
  document.getAnimations().forEach((a) => {
    a.pause();
    a.currentTime = Math.max(0, t - DIAGRAM_AT) * 1000;
  });
}
const $ = (s) => document.querySelector(s);
const $$ = (s) => [...document.querySelectorAll(s)];

// ---- chrome
at("#bar", 0, DURATION, { sx: [0, 1] }, { ease: "lin" });
for (const sc of SCENES) {
  at(`#${sc.id}`, sc.a, 0.01, { o: [0, 1] }, { ease: "lin" });
  at(`#${sc.id}`, sc.b - 0.5, 0.5, { o: [1, 0] }, { ease: "inout" });
  at(`#${sc.id} .sh`, sc.a + 0.15, 0.8, { o: [0, 1], y: [26, 0], clip: [[0, 0, 100, 0], [-20, -20, -20, -20]] }, { stagger: 0.12 });
  at(`#${sc.id} .sh`, sc.b - 0.5, 0.5, { y: [0, -24] }, { ease: "inout" });
  at(`#tag-${sc.id}`, sc.a + 0.3, 0.6, { o: [0, 1], y: [10, 0] });
  at(`#tag-${sc.id}`, sc.b - 0.4, 0.4, { o: [1, 0] }, { ease: "inout" });
}
at("#who", SCENES[2].a + 0.3, 0.8, { o: [0, 1] });
at("#who", DURATION - 6.4, 0.5, { o: [1, 0] });

// ---- 1 title
at("#t-mark", 0.3, 1.2, { o: [0, 1], s: [0.82, 1], blur: [14, 0] });
at(".t-ch", 0.75, 0.9, { o: [0, 1], y: [70, 0], clip: [[0, 0, 100, 0], [-20, -20, -20, -20]] }, { stagger: 0.07 });
at("#t-u", 1.55, 1.0, { sx: [0, 1] });
at("#t-line", 2.0, 0.9, { o: [0, 1], y: [20, 0] });
at("#t-credit", 2.6, 0.9, { o: [0, 1], y: [14, 0] });
at(["#t-mark", "#t-h1", "#t-line", "#t-credit"], 5.4, 0.7, { y: [0, -40], blur: [0, 8] }, { ease: "inout", stagger: 0.04 });
const S = Object.fromEntries(SCENES.map((s) => [s.id, s]));

// ---- 2 product
{
  const a = S.s2.a;
  at("#win", a, 1.4, { o: [0, 1], y: [90, 0], rx: [14, 0], s: [0.93, 1] });
  at("#note", a + 0.9, 0.8, { o: [0, 1] });
  at("#q", a + 1.2, 1.6, { type: [0, 1] }, { ease: "lin" });
  at("#q", a + 1.0, 0.3, { o: [0, 1] });
  $$(".st").forEach((li, i) => {
    const s = a + 3.1 + i * 0.75;
    at(li, s, 0.45, { o: [0, 1], y: [10, 0] });
    at(li.querySelector(".ring"), s, 0.65, { r: [0, 340], o: [1, 1] }, { ease: "lin" });
    at(li.querySelector(".ring"), s + 0.65, 0.01, { o: [1, 0] }, { ease: "lin" });
    at(li.querySelector(".fill"), s + 0.62, 0.25, { o: [0, 1], s: [0.6, 1] });
  });
  const r = a + 3.1 + $$(".st").length * 0.75 + 0.2;
  at("#ans", r, 1.0, { o: [1, 1], clip: [[0, 100, 0, 0], [0, -2, 0, 0]] }, { ease: "inout" });
  at("#tbl", r + 0.5, 0.6, { o: [0, 1], y: [12, 0] });
  at(".tr", r + 0.7, 0.5, { o: [0, 1], y: [10, 0] }, { stagger: 0.16 });
  at("#art", r + 1.4, 0.7, { o: [0, 1], y: [14, 0] });
  at("#stamp", r + 1.8, 0.6, { o: [0, 1] });
  at("#hot", r + 2.6, 0.5, { o: [0, 1], s: [1.2, 1] });
  at("#win", r + 2.4, 2.2, { s: [1, 1.16], y: [0, -200] }, { ease: "inout" });
  at("#win", S.s2.b - 0.7, 0.7, { x: [0, -260], blur: [0, 10] }, { ease: "inout" });
  at("#note", S.s2.b - 0.7, 0.4, { o: [1, 0] });
}

// ---- 3 loop
{
  const a = S.s3.a, n = $$("#loop .step").length;
  at("#rail", a + 0.5, 1.2, { sx: [0, 1] }, { ease: "inout" });
  at("#loop .step", a + 0.7, 0.7, { o: [0.0, 0.3], y: [16, 0] }, { stagger: 0.12 });
  at("#pulse", a + 1.6, 3.0, { x: [0, (1600 * (n - 1)) / n] }, { ease: "inout" });
  at("#pulse", a + 1.4, 0.3, { o: [0, 1], s: [0.4, 1] });
  at("#loop .step", a + 1.6, 0.4, { o: [0.3, 1] }, { stagger: 3.0 / (n - 1) });
  at("#ret-path", a + 4.7, 1.2, { draw: [1, 0] }, { ease: "inout" });
  at("#ret-path", a + 4.7, 0.01, { o: [0, 1] });
  at("#ret-head", a + 5.8, 0.3, { o: [0, 1] });
  at("#pulse", a + 4.7, 1.2, { o: [1, 0] });
  at("#loop-note", a + 5.6, 0.8, { o: [0, 1], y: [16, 0] });
}

// ---- 4 capabilities
at(".cap", S.s4.a + 0.7, 0.8, { o: [0, 1], y: [30, 0], clip: [[0, 0, 100, 0], [-20, -20, -20, -20]] }, { stagger: 0.22 });

// ---- 5, 6, 8 sentences with counts
for (const id of ["s5", "s6", "s8"]) {
  const a = S[id].a, lines = $$(`.ln-${id}`);
  lines.forEach((p, i) => {
    const s = a + 0.8 + i * 1.15;
    at(p, s, 0.8, { o: [0, 1], y: [24, 0], clip: [[0, 0, 100, 0], [-20, -20, -20, -20]] });
    const c = p.querySelector(".cnt");
    if (c) at(c, s, 1.3, { count: [0, Number(c.dataset.to)] });
  });
}
{
  const a = S.s6.a, sq = $$("#inst i");
  at("#inst", a + 0.6, 0.01, { o: [0, 1] }, { ease: "lin" });
  sq.forEach((q, i) => at(q, a + 3.2 + i * 0.03, 0.2, { o: [i === 0 ? 1 : 0.12, 1] }));
  sq.forEach((q, i) => i > 0 && at(q, a + 4.6 + (sq.length - i) * 0.025, 0.2, { o: [1, 0.12] }));
  at(sq[0], a, 0.01, { o: [1, 1] });
}

// ---- 7 platform, year by year
{
  const a = S.s7.a, step = 1.75, first = a + 1.1;
  const years = $$(".y-num"), eras = $$(".y-era"), lines = $$(".y-line");
  years.forEach((_, i) => {
    const s = first + i * step;
    for (const set of [years, eras, lines]) {
      at(set[i], s, 0.55, { o: [0, 1], y: [30, 0] });
      if (i < years.length - 1) at(set[i], s + step - 0.25, 0.3, { o: [1, 0], y: [0, -24] }, { ease: "inout" });
    }
    $$(".meas .row").forEach((row) => {
      const vals = row.querySelectorAll(".v");
      at(vals[i], s + 0.1, 0.4, { o: [0, 1], y: [10, 0] });
      if (i < vals.length - 1) at(vals[i], s + step - 0.2, 0.25, { o: [1, 0] }, { ease: "inout" });
      const bar = row.querySelector(".track i"), sh = bar.dataset.shares.split(",").map(Number);
      at(bar, s, 0.9, { sx: [i ? sh[i - 1] : 0, sh[i]] }, { ease: "inout" });
    });
  });
}

// ---- 9 savings
{
  const a = S.s9.a;
  $$(".mrow").forEach((row, i) => {
    const s = a + 0.8 + i * 0.75;
    at(row, s, 0.6, { o: [0, 1], y: [16, 0] });
    at(row.querySelector(".strike"), s + 0.45, 0.5, { sx: [0, 1] }, { ease: "inout" });
    at(row.querySelector(".stop"), s + 0.6, 0.4, { o: [1, 0.55] });
    at([row.querySelector(".arrow"), row.querySelector(".inst2")], s + 0.75, 0.6, { o: [0, 1], x: [-24, 0] }, { stagger: 0.08 });
  });
  at("#close", a + 0.8 + $$(".mrow").length * 0.75 + 0.3, 0.9, { o: [0, 1], y: [20, 0], clip: [[0, 0, 100, 0], [-20, -20, -20, -20]] });
}

// ---- 10 diagram
at("#dia", S.s10.a, S.s10.b - S.s10.a, { s: [0.97, 1.03] }, { ease: "lin" });

// ---- 11 end
{
  const a = S.s11.a;
  at("#e-h", a + 0.2, 1.0, { o: [0, 1], y: [50, 0], clip: [[0, 0, 100, 0], [-20, -20, -20, -20]] });
  at("#e-u", a + 1.0, 1.0, { sx: [0, 1] });
  at("#e-role", a + 1.4, 0.8, { o: [0, 1], y: [16, 0] });
  at("#e-url", a + 1.9, 0.8, { o: [0, 1], y: [16, 0] });
}
// the last scene holds to the end rather than fading
for (const k of Object.keys(tracks.get($("#s11")) || {})) tracks.get($("#s11"))[k] = tracks.get($("#s11"))[k].filter((tw) => tw.b !== 0);
window.render = render;
window.DURATION = DURATION;
render(0);
</script>
</body>
</html>
