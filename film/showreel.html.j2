<!doctype html>
<!-- The showreel film. Rendered by scripts/make_film.py from profile/profile.yaml (site.showreel);
     every figure and line comes from there, and the accounts in the demo are invented. The page is
     a 1920x1080 stage: render(t) sets every element for time t, and the site's own object renderer
     draws the turning objects, so the film is captured frame by frame and every frame is exact. -->
<html lang="en-GB">
<head>
<meta charset="utf-8">
<title>Showreel</title>
<style>
@font-face { font-family: "Mona Sans"; font-weight: 200 900; font-stretch: 75% 125%; src: url("{{ font_url }}") format("woff2"); }
:root { --field: #0c0c0e; --ink: #f2efe9; --ink-2: #b3aea5; --ink-3: #8a857d; --line: rgb(242 239 233 / 0.12); --accent: #ff4a1c; --panel: #161618; --rule: rgb(242 239 233 / 0.11); }
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: 1920px; height: 1080px; overflow: hidden; background: var(--field); }
body { font-family: "Mona Sans", sans-serif; color: var(--ink); font-feature-settings: "ss01", "cv11"; -webkit-font-smoothing: antialiased; font-variant-numeric: tabular-nums; }
.stage { position: relative; width: 1920px; height: 1080px; overflow: hidden; }
.scene { position: absolute; inset: 0; opacity: 0; }
.abs { position: absolute; }
.credit { font-size: 20px; font-weight: 560; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
.mega { font-size: 112px; font-weight: 600; letter-spacing: -0.045em; line-height: 1.02; }
.cap { font-size: 96px; font-weight: 600; letter-spacing: -0.045em; line-height: 1.02; }
.giant { font-size: 300px; font-weight: 600; letter-spacing: -0.06em; line-height: 0.9; }
.say { font-size: 40px; color: var(--ink-2); letter-spacing: -0.015em; line-height: 1.3; }
.centre { left: 0; right: 0; text-align: center; }
.w { display: inline-block; }
.mask { display: inline-block; background: currentColor; -webkit-mask: url("{{ mark_url }}") center / contain no-repeat; mask: url("{{ mark_url }}") center / contain no-repeat; }
canvas.obj { position: absolute; width: 900px; height: 900px; }
.bar { position: absolute; top: 0; left: 0; height: 3px; width: 1920px; background: var(--accent); transform-origin: left center; z-index: 9; }
.foot { position: absolute; left: 120px; right: 120px; bottom: 50px; display: flex; justify-content: space-between; z-index: 9; }
.foot .tags { position: relative; height: 24px; width: 600px; }
.foot .tag { position: absolute; right: 0; top: 0; opacity: 0; white-space: nowrap; }

/* chat window */
.win { position: absolute; width: 1020px; height: 760px; background: var(--panel); border: 1px solid var(--rule); border-radius: 22px; overflow: hidden; display: grid; grid-template-rows: auto 1fr auto; font-size: 21px; line-height: 1.45; transform-origin: 0% 75%; }
.win-bar { display: flex; align-items: center; gap: 14px; padding: 18px 26px; border-bottom: 1px solid var(--rule); }
.win-bar .mask { width: 28px; height: 27px; color: var(--ink); } .win-bar b { font-weight: 560; font-size: 23px; }
.chip { font-size: 14px; font-weight: 560; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-3); border: 1px solid var(--rule); border-radius: 99px; padding: 3px 12px; }
.dots { margin-left: auto; display: flex; gap: 6px; } .dots i { width: 6px; height: 6px; border-radius: 50%; background: var(--ink-3); }
.convo { padding: 26px 36px; display: grid; gap: 16px; align-content: start; }
.you { justify-self: end; width: 82%; background: rgb(242 239 233 / 0.09); border-radius: 20px 20px 6px 20px; padding: 14px 22px; min-height: 92px; }
.steps { list-style: none; display: grid; gap: 8px; font-size: 18px; color: var(--ink-2); }
.steps li { display: flex; align-items: center; gap: 14px; }
.dot { position: relative; width: 24px; height: 24px; flex: none; }
.dot .ring { position: absolute; inset: 0; border-radius: 50%; border: 2px solid rgb(242 239 233 / 0.25); border-top-color: var(--ink); }
.dot .fill { position: absolute; inset: 0; border-radius: 50%; background: var(--ink); display: grid; place-items: center; }
.reply { display: grid; gap: 12px; }
table.t { width: 100%; border-collapse: collapse; font-size: 17px; }
.t th { text-align: left; font-size: 13px; font-weight: 560; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-3); padding: 0 14px 8px 0; }
.t td { padding: 7px 14px 7px 0; border-top: 1px solid var(--rule); color: var(--ink-2); }
.t th:not(:first-child), .t td:not(:first-child) { text-align: right; } .t th:last-child, .t td:last-child { padding-right: 0; }
.t td:first-child, .t td:last-child { color: var(--ink); }
.art { display: flex; align-items: center; gap: 16px; border: 1px solid var(--rule); border-radius: 12px; padding: 12px 16px; width: 560px; }
.thumb { width: 46px; height: 46px; border-radius: 8px; background: rgb(242 239 233 / 0.09); display: grid; place-items: center; color: var(--ink-2); }
.art .nm { font-weight: 540; display: block; } .art .mt { font-size: 16px; color: var(--ink-3); }
.open { position: relative; margin-left: auto; font-size: 17px; font-weight: 540; border: 1px solid var(--rule); border-radius: 99px; padding: 5px 16px; }
.open i { position: absolute; inset: -1px; border-radius: 99px; border: 2px solid var(--accent); }
.stamp { font-size: 14px; font-weight: 560; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-3); }
.composer { margin: 0 24px 22px; border: 1px solid var(--rule); border-radius: 14px; padding: 12px 14px 12px 20px; display: flex; align-items: center; gap: 12px; color: var(--ink-3); }
.send { margin-left: auto; width: 36px; height: 36px; border-radius: 50%; background: var(--ink); color: var(--field); display: grid; place-items: center; }
.capstack { position: absolute; left: 120px; top: 390px; width: 600px; height: 260px; }
.capstack .cap { position: absolute; left: 0; top: 0; font-size: 76px; opacity: 0; }

/* truths */
.truth-line { top: 210px; }
.t1 svg { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; }
.t1 svg path { fill: none; stroke: var(--ink-3); stroke-width: 1.5; }
.t1 .part { position: absolute; font-size: 34px; font-weight: 520; letter-spacing: -0.01em; white-space: nowrap; }
.t1 .hub { position: absolute; left: 905px; top: 660px; width: 110px; height: 106px; color: var(--ink); }
.t1 .ping { position: absolute; left: 860px; top: 613px; width: 200px; height: 200px; border-radius: 50%; border: 2px solid var(--accent); }
.mt2 { position: absolute; left: 460px; top: 470px; width: 1000px; border-collapse: collapse; font-size: 26px; }
.mt2 th { text-align: left; font-size: 16px; font-weight: 560; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-3); padding: 0 0 14px; }
.mt2 td { padding: 13px 0; border-top: 1px solid var(--line); position: relative; }
.mt2 td.m span.v { display: inline-block; }
.mt2 td.m i { position: absolute; left: 0; top: 50%; height: 18px; margin-top: -9px; width: 230px; border-radius: 4px; background: var(--ink-3); transform-origin: left center; }
.scan { position: absolute; left: 440px; width: 1040px; height: 2px; background: var(--accent); top: 470px; }
.badge { position: absolute; left: 460px; top: 820px; }
.t3row { position: absolute; left: 260px; right: 260px; top: 480px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 60px; }
.t3row > div { display: grid; justify-items: center; gap: 26px; text-align: center; }
.t3row svg { width: 150px; height: 150px; overflow: visible; }
.t3row svg * { fill: none; stroke: var(--ink); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.t3row #t3-hand { transform-origin: 12px 12px; }
.t3row .t3-bar { transform-origin: center 12px; transform-box: fill-box; }
.t3row span { font-size: 34px; font-weight: 520; }
.t3row .prog { width: 220px; height: 4px; background: var(--line); border-radius: 2px; overflow: hidden; } .t3row .prog i { display: block; height: 100%; background: var(--accent); transform-origin: left center; }
.net { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; }
.net line { stroke: var(--ink-3); stroke-width: 1.2; stroke-dasharray: 1; }
.net circle { fill: var(--ink); transform-box: fill-box; transform-origin: center; }
.net circle.c { fill: var(--accent); }
.tnote { top: 920px; }

/* numbers */
.num { top: 300px; }
.num-say { top: 640px; }

/* stack */
.stack3d { position: absolute; left: 400px; top: 440px; width: 560px; height: 560px; transform-style: preserve-3d; }
.slab { position: absolute; inset: 0; border: 2px solid var(--ink-3); background: rgb(22 22 24 / 0.94); border-radius: 18px; }
.slab.top { border-color: var(--ink); }
.slab .g { position: absolute; inset: 44px; display: grid; gap: 14px; }
.slab .g i { border: 1.5px solid var(--ink-3); border-radius: 4px; }
.slab .mk { position: absolute; left: 170px; top: 174px; width: 220px; height: 210px; color: var(--ink); transform: rotate(40deg); }
.slabel { position: absolute; left: 1180px; font-size: 44px; font-weight: 540; letter-spacing: -0.02em; white-space: nowrap; opacity: 0; }
.slabel::before { content: ""; position: absolute; right: calc(100% + 24px); top: 50%; width: 180px; height: 1px; background: var(--ink-3); }
.bridge { top: 96px; }

/* platform shifts */
.ptitle { position: absolute; left: 160px; top: 170px; }
.yr { position: absolute; left: 164px; top: 330px; height: 30px; width: 500px; }
.yr span { position: absolute; left: 0; top: 0; opacity: 0; white-space: nowrap; }
.morph { position: absolute; left: 150px; top: 400px; height: 300px; width: 900px; }
.morph span { position: absolute; left: 0; top: 0; opacity: 0; white-space: nowrap; }
.grid100 { position: absolute; left: 1150px; top: 300px; display: grid; grid-template-columns: repeat(10, 46px); gap: 12px; }
.grid100 i { position: relative; width: 46px; height: 46px; border-radius: 6px; background: var(--ink); }
.grid100 i.f { background: transparent; box-shadow: inset 0 0 0 2px var(--ink-3); }
.grid100 i b { position: absolute; inset: 0; border-radius: 6px; background: var(--ink); }
.blocks { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; }
.blocks i { position: absolute; left: 0; top: 0; width: 56px; height: 30px; border-radius: 5px; border: 2px solid var(--ink-2); background: rgb(242 239 233 / 0.06); opacity: 0; }
.pnote { position: absolute; left: 160px; top: 880px; }
.git { position: absolute; left: 160px; right: 160px; top: 760px; height: 80px; }
.git .rail { position: absolute; left: 0; right: 0; top: 39px; height: 2px; background: var(--ink-3); transform-origin: left center; }
.git .c { position: absolute; top: 18px; width: 44px; height: 44px; border-radius: 50%; border: 2px solid var(--ink-2); background: var(--field); }
.git .c b { position: absolute; inset: -2px; border-radius: 50%; background: var(--ink); display: grid; place-items: center; }
.git .c svg { width: 22px; height: 22px; }

/* scale */
.spines { position: absolute; left: 160px; right: 160px; bottom: 140px; height: 300px; display: flex; align-items: flex-end; gap: 4px; }
.spines i { flex: 1; background: var(--ink); border-radius: 2px 2px 0 0; transform-origin: bottom center; }
.spines i:nth-child(5n+2) { background: var(--ink-2); } .spines i:nth-child(7n+3) { background: var(--ink-3); } .spines i:nth-child(23n) { background: var(--accent); }
.big-left { position: absolute; left: 150px; top: 150px; }
.say-left { position: absolute; left: 160px; width: 1100px; }
.pulse { position: absolute; left: 1420px; top: 330px; width: 280px; height: 280px; }
.pulse i { position: absolute; inset: 0; border-radius: 50%; border: 2px solid var(--accent); }
.pulse b { position: absolute; left: 120px; top: 120px; width: 40px; height: 40px; border-radius: 50%; background: var(--accent); }
.dots160 { position: absolute; left: 1010px; top: 300px; display: grid; grid-template-columns: repeat(16, 30px); gap: 16px; }
.dots160 i { width: 30px; height: 30px; border-radius: 50%; background: var(--ink); }
.plabel { position: absolute; left: 1010px; top: 760px; height: 30px; width: 400px; }
.plabel span { position: absolute; left: 0; top: 0; opacity: 0; }

/* savings */
.money { position: absolute; left: 160px; right: 160px; top: 330px; display: grid; gap: 12px; }
.money .row { display: grid; grid-template-columns: 640px 50px 1fr; align-items: center; gap: 24px; border-top: 1px solid var(--line); padding-top: 12px; }
.money .stop { position: relative; white-space: nowrap; font-size: 40px; font-weight: 530; letter-spacing: -0.02em; justify-self: start; }
.money .strike { position: absolute; left: -6px; right: -6px; top: 54%; height: 4px; background: var(--accent); transform-origin: left center; }
.money .arrow { color: var(--ink-3); }
.money .inst2 { font-size: 34px; }
.money .amt { display: block; font-size: 20px; color: var(--ink-3); margin-top: 4px; }

/* diagram */
.dia { position: absolute; left: 160px; top: 330px; width: 1600px; transform-origin: 50% 50%; }
.dia svg { width: 1600px; height: auto; display: block; }

/* end */
.endname { top: 640px; }
.endrole { top: 790px; }
.endurl { top: 856px; }
.objlab { position: absolute; top: 590px; width: 600px; text-align: center; }
</style>
</head>
<body>
<div class="stage">
  <div class="bar" id="bar"></div>

  <section class="scene" id="s-open">
    <p class="credit abs centre" id="o-cred" style="top:370px">{{ name }} · South Pole</p>
    {% set halves = film.open.split(', ', 1) %}
    <h1 class="mega abs centre" id="o-h" style="top:440px">{% for w in (halves[0] ~ ',').split(' ') %}<span class="w ow">{{ w }}</span> {% endfor %}<br><span style="position:relative;display:inline-block">{% for w in halves[1].split(' ') %}<span class="w ow">{{ w }}</span> {% endfor %}<i id="o-line" style="position:absolute;left:0;right:28px;bottom:-14px;height:6px;background:var(--accent);transform-origin:left center"></i></span></h1>
  </section>

  <section class="scene" id="s-orca">
    <p class="abs centre" id="or-word" style="top:110px;font-size:420px;font-weight:620;letter-spacing:-0.06em;line-height:1">Orca</p>
    <canvas class="obj" id="or-obj" data-slug="orca" width="900" height="900" style="left:510px;top:170px"></canvas>
    <p class="say abs centre" id="or-say" style="top:930px">{{ film.orca_line }}</p>
  </section>

  <section class="scene" id="s-ask" style="perspective:2400px">
    <div class="capstack">{% for c in film.ask %}<p class="cap ac">{{ c }}</p>{% endfor %}</div>
    <div class="win" id="win" style="left:780px;top:150px">
      <div class="win-bar"><span class="mask"></span><b>Orca</b><span class="chip">New chat</span><span class="dots"><i></i><i></i><i></i></span></div>
      <div class="convo">
        <p class="you" id="q" data-full="{{ demo.question }}"></p>
        <ol class="steps">{% for s in demo.steps %}<li class="st"><span class="dot"><span class="ring"></span><span class="fill"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0c0c0e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span></span><span>{{ s }}</span></li>{% endfor %}</ol>
        <div class="reply">
          <p id="ans">{{ demo.answer }}</p>
          <table class="t" id="tbl"><thead><tr>{% for h in demo.table.head %}<th>{{ h }}</th>{% endfor %}</tr></thead><tbody>{% for r in demo.table.rows %}<tr class="tr">{% for c in r %}<td>{{ c }}</td>{% endfor %}</tr>{% endfor %}</tbody></table>
          <div class="art" id="art"><span class="thumb"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm8 11v4m-4 0h8"/></svg></span><span><span class="nm">{{ demo.artefact.name }}</span><span class="mt">{{ demo.artefact.meta }}</span></span><span class="open">Open<i id="hot"></i></span></div>
          <p class="stamp" id="stamp">{{ demo.stamp }}</p>
        </div>
      </div>
      <div class="composer"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg><span>Ask Orca</span><span class="send"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5m-6 6 6-6 6 6"/></svg></span></div>
    </div>
    <p class="abs" id="ask-note" style="left:120px;top:960px;font-size:18px;color:var(--ink-3)">{{ demo.note }}</p>
  </section>

  <section class="scene t1" id="s-t1">
    <p class="cap abs centre truth-line tl">{{ film.truths[0].line }}</p>
    <svg viewBox="0 0 1920 1080">{% for p in t1_parts %}<path class="t1l" pathLength="1" stroke-dasharray="1" d="M{{ p.lx }} {{ p.ly }} C{{ p.cx }} {{ p.ly }} {{ p.cx }} 713 {{ p.hx }} 713"/>{% endfor %}</svg>
    {% for p in t1_parts %}<span class="part t1p" style="{{ p.style }}">{{ p.name }}</span>{% endfor %}
    <i class="ping" id="t1-ping"></i>
    <span class="mask hub" id="t1-hub"></span>
  </section>

  <section class="scene" id="s-t2">
    <p class="cap abs centre truth-line tl">{{ film.truths[1].line }}</p>
    <table class="mt2" id="mt2"><thead id="mt2h"><tr><th>Account</th><th>Region</th><th>Owner</th><th>Contact</th></tr></thead><tbody>
      {% for r in mask_rows %}<tr class="mr"><td>{{ r[0] }}</td><td>{{ r[1] }}</td><td>{{ r[2] }}</td><td class="m"><span class="v">{{ r[3] }}</span><i></i></td></tr>{% endfor %}
    </tbody></table>
    <i class="scan" id="scan"></i>
    <p class="credit badge" id="badge">{{ film.truths[1].note }}</p>
  </section>

  <section class="scene" id="s-t3">
    <p class="cap abs centre truth-line tl">{{ film.truths[2].line }}</p>
    <div class="t3row">
      <div class="t3"><svg viewBox="0 0 24 24"><path d="M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V8l-4-5Zm0 0v5h4M9 13h6M9 17h4"/></svg><span>{{ film.truths[2].parts[0] }}</span><span class="prog"><i id="t3-prog"></i></span></div>
      <div class="t3"><svg viewBox="0 0 24 24"><path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z"/><path id="t3-hand" d="M12 12V6.5"/><path d="M12 12l4 2"/></svg><span>{{ film.truths[2].parts[1] }}</span></div>
      <div class="t3"><svg viewBox="0 0 24 24"><path d="M4 5h16a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm8 11v4m-4 0h8"/><path class="t3-bar" d="M7 12V10"/><path class="t3-bar" d="M10 12V8"/><path class="t3-bar" d="M13 12V9"/><path class="t3-bar" d="M16 12V7"/></svg><span>{{ film.truths[2].parts[2] }}</span></div>
    </div>
  </section>

  <section class="scene" id="s-t4">
    <p class="cap abs centre truth-line tl">{{ film.truths[3].line }}</p>
    <svg class="net" viewBox="0 0 1920 1080">{% for l in net_links %}<line class="nl" x1="{{ l[0] }}" y1="{{ l[1] }}" x2="{{ l[2] }}" y2="{{ l[3] }}" pathLength="1"/>{% endfor %}{% for n in net_nodes %}<circle class="nn{% if n[3] %} c{% endif %}" data-order="{{ n[4] }}" cx="{{ n[0] }}" cy="{{ n[1] }}" r="{{ n[2] }}"/>{% endfor %}</svg>
    <p class="say abs centre tnote" id="t4-note">{{ film.truths[3].note }}</p>
  </section>

  {% for a in adoption %}
  <section class="scene sn" id="s-n{{ loop.index0 }}">
    <p class="giant abs centre num"><span class="cnt" data-to="{{ a.count }}" data-comma="{{ 1 if a.comma else 0 }}">{{ a.lead }}</span></p>
    <p class="say abs centre num-say" style="font-size:46px">{{ a.text }}</p>
  </section>
  {% endfor %}

  <section class="scene" id="s-stack">
    <p class="cap abs centre bridge" id="br0">{{ film.bridge[0] }}</p>
    <p class="cap abs centre bridge" id="br1" style="opacity:0">{{ film.bridge[0] }} <span style="color:var(--accent)">{{ film.bridge[1] }}</span></p>
    <div class="stack3d" id="stack3d" data-base="perspective(3000px) rotateX(58deg) rotateZ(-40deg)" style="transform:perspective(3000px) rotateX(58deg) rotateZ(-40deg)">
      {% for s in film.stack|reverse %}<div class="slab{% if loop.last %} top{% endif %}">
        {% if loop.last %}<span class="mask mk"></span>{% elif loop.index0 == 1 %}<span class="g" style="grid-template-columns:repeat(6,1fr)">{% for i in range(36) %}<i></i>{% endfor %}</span>{% elif loop.index0 == 2 %}<span class="g" style="grid-template-columns:repeat(3,1fr)">{% for i in range(9) %}<i style="border-radius:50%"></i>{% endfor %}</span>{% else %}<span class="g" style="grid-template-columns:repeat(2,1fr)">{% for i in range(4) %}<i></i>{% endfor %}</span>{% endif %}
      </div>{% endfor %}
    </div>
    {% for s in film.stack %}<p class="slabel" data-i="{{ loop.index0 }}" style="top:{{ stack_label_y[loop.index0] }}px">{{ s }}</p>{% endfor %}
  </section>

  <section class="scene" id="s-plat">
    <p class="abs centre" id="pl-word" style="top:150px;font-size:330px;font-weight:620;letter-spacing:-0.06em;line-height:1">Platform</p>
    <canvas class="obj" id="pl-obj" data-slug="enterprise-data-platform-migration" width="900" height="900" style="left:510px;top:160px"></canvas>
    <p class="say abs centre" id="pl-say" style="top:930px">{{ film.platform_line }}</p>
  </section>

  <section class="scene" id="s-runs">
    <p class="cap ptitle sh">{{ film.runs.title }}</p>
    <p class="credit yr"><span class="y0">{{ film.runs.from_year }}</span><span class="y1">{{ film.runs.to_year }}</span></p>
    <p class="giant morph"><span class="m0">{{ film.runs.from }}</span><span class="m1">{{ film.runs.to }}</span></p>
    <div class="grid100">{% for i in range(100) %}<i class="g1{% if i in run_fails %} f{% endif %}">{% if i in run_fails %}<b></b>{% endif %}</i>{% endfor %}</div>
  </section>

  <section class="scene" id="s-code">
    <p class="cap ptitle sh">{{ film.code.title }}</p>
    <p class="credit yr"><span class="y0">{{ film.code.from_year }} · {{ film.code.from_label }}</span><span class="y1">{{ film.code.to_year }}</span></p>
    <div class="blocks">{% for b in code_blocks %}<i data-x0="{{ b[0] }}" data-y0="{{ b[1] }}" data-r0="{{ b[2] }}" data-x1="{{ b[3] }}" data-y1="{{ b[4] }}"></i>{% endfor %}</div>
    <p class="say pnote" id="code-note">{{ film.code.note }}</p>
  </section>

  <section class="scene" id="s-review">
    <p class="cap ptitle sh">{{ film.review.title }}</p>
    <p class="credit yr"><span class="y0">{{ film.review.from_year }}</span><span class="y1">{{ film.review.to_year }}</span></p>
    <p class="giant morph" style="font-size:220px"><span class="m0">{{ film.review.from }}</span><span class="m1">{{ film.review.to }}</span></p>
    <div class="git"><i class="rail" id="git-rail"></i>{% for c in commits %}<span class="c gc" style="left:{{ c.x }}px"><b class="{{ 'late' if not c.ok else 'ok' }}"><svg viewBox="0 0 24 24" fill="none" stroke="#0c0c0e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></b></span>{% endfor %}</div>
  </section>

  <section class="scene" id="s-books">
    <p class="giant big-left sh">{{ film.books.lead }}</p>
    <p class="say say-left sh" style="top:470px">{{ film.books.text }}</p>
    <div class="spines">{% for h in spines %}<i style="height:{{ h }}%"></i>{% endfor %}</div>
  </section>

  <section class="scene" id="s-ticker">
    <p class="giant big-left" style="top:300px"><span class="cnt" id="tick" data-to="{{ ticker_count }}" data-comma="1">{{ film.ticker.lead }}</span></p>
    <p class="say say-left" id="tick-say" style="top:640px">{{ film.ticker.text }}</p>
    <div class="pulse"><i class="pr"></i><i class="pr"></i><i class="pr"></i><b id="pb"></b></div>
  </section>

  <section class="scene" id="s-people">
    <p class="giant big-left" style="top:300px"><span class="cnt" id="ppl" data-from="{{ film.people.from }}" data-to="{{ film.people.to }}">{{ film.people.to }}</span></p>
    <p class="say say-left" id="ppl-say" style="top:640px;width:760px">{{ film.people.text }}</p>
    <div class="dots160">{% for i in range(film.people.to) %}<i class="{% if i < film.people.from %}d0{% else %}d1{% endif %}"></i>{% endfor %}</div>
    <p class="credit plabel"><span class="y0">{{ film.people.from_label }}</span><span class="y1">{{ film.people.to_label }}</span></p>
  </section>

  <section class="scene" id="s-save">
    <p class="cap ptitle sh">{{ film.savings }}</p>
    <div class="money">{% for m in money %}<div class="row mrow"><span class="stop">{{ m.stopped }}<i class="strike"></i></span><svg class="arrow" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg><span class="inst2">{{ m.instead }}<span class="amt">{{ m.amount }}</span></span></div>{% endfor %}</div>
  </section>
  <section class="scene" id="s-close">
    <p class="cap abs centre" id="close" style="top:470px">{{ film.close }}</p>
  </section>

  <section class="scene" id="s-fits">
    <p class="cap ptitle sh" style="font-size:72px">How it fits together.</p>
    <div class="dia" id="dia">{{ diagram|safe }}</div>
  </section>

  <section class="scene" id="s-end">
    <canvas class="obj" id="e-o1" data-slug="orca" width="900" height="900" style="left:330px;top:60px;width:560px;height:560px"></canvas>
    <canvas class="obj" id="e-o2" data-slug="enterprise-data-platform-migration" width="900" height="900" style="left:1030px;top:60px;width:560px;height:560px"></canvas>
    <p class="credit objlab" id="e-l1" style="left:310px">Orca</p>
    <p class="credit objlab" id="e-l2" style="left:1010px">The data platform</p>
    <p class="mega abs centre endname" id="e-name">{{ name }}</p>
    <p class="say abs centre endrole" id="e-role">{{ role }}</p>
    <p class="say abs centre endurl" id="e-url" style="color:var(--ink)">saahil.co.uk</p>
  </section>

  <div class="foot"><span class="credit" id="who">{{ name }}</span><span class="tags">{% for act in acts %}<span class="credit tag act" data-a="{{ act.a }}" data-b="{{ act.b }}">{{ act.tag }}</span>{% endfor %}</span></div>
</div>

<script src="stage.js"></script>
<script>
const DURATION = {{ duration }};
const SCENES = {{ scenes_json|safe }};
const S = Object.fromEntries(SCENES.map((s) => [s.id, s]));
// ---- a small deterministic timeline: tweens keyed by element and property, evaluated at t
const tracks = new Map();
const E = {
  out: (t) => 1 - Math.pow(1 - t, 4),
  out2: (t) => 1 - Math.pow(1 - t, 2),
  inout: (t) => (t < 0.5 ? 8 * t ** 4 : 1 - Math.pow(-2 * t + 2, 4) / 2),
  soft: (t) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2),
  lin: (t) => t,
  back: (t) => 1 + 2.2 * Math.pow(t - 1, 3) + 1.2 * Math.pow(t - 1, 2),
};
function at(sel, start, dur, props, opt = {}) {
  const pick = (x) => (typeof x === "string" ? [...document.querySelectorAll(x)] : [x]);
  const els = (Array.isArray(sel) ? sel.flatMap(pick) : pick(sel)).filter(Boolean);
  els.forEach((el, i) => {
    const s = start + (typeof opt.stagger === "function" ? opt.stagger(i, el) : i * (opt.stagger || 0));
    let tr = tracks.get(el);
    if (!tr) tracks.set(el, (tr = {}));
    for (const [k, v] of Object.entries(props)) (tr[k] ||= []).push({ s, d: Math.max(dur, 0.0001), a: v[0], b: v[1], e: E[opt.ease || "out"] });
  });
}
const lerp = (a, b, p) => (Array.isArray(a) ? a.map((x, i) => x + (b[i] - x) * p) : a + (b - a) * p);
function value(list, t) {
  let cur = null;
  for (const tw of list) if (t >= tw.s && (!cur || tw.s >= cur.s)) cur = tw;
  if (!cur) return list.reduce((m, x) => (x.s < m.s ? x : m)).a;
  return lerp(cur.a, cur.b, cur.e(Math.min(1, (t - cur.s) / cur.d)));
}
let STAGE = null;
function render(t) {
  const spins = [];
  for (const [el, tr] of tracks) {
    const v = {};
    for (const k in tr) v[k] = value(tr[k], t);
    if ("o" in v) el.style.opacity = v.o;
    const tf = [];
    if ("x" in v || "y" in v || "z" in v) tf.push(`translate3d(${v.x || 0}px, ${v.y || 0}px, ${v.z || 0}px)`);
    if ("rx" in v) tf.push(`rotateX(${v.rx}deg)`);
    if ("ry" in v) tf.push(`rotateY(${v.ry}deg)`);
    if ("r" in v) tf.push(`rotate(${v.r}deg)`);
    if ("s" in v) tf.push(`scale(${v.s})`);
    if ("sx" in v) tf.push(`scaleX(${v.sx})`);
    if ("sy" in v) tf.push(`scaleY(${v.sy})`);
    if (tf.length) el.style.transform = `${el.dataset.pre || ""} ${tf.join(" ")} ${el.dataset.base || ""}`;
    if ("blur" in v) el.style.filter = v.blur > 0.05 ? `blur(${v.blur}px)` : "none";
    if ("clip" in v) el.style.clipPath = `inset(${v.clip.map((c) => c + "%").join(" ")})`;
    if ("draw" in v) el.style.strokeDashoffset = v.draw;
    if ("type" in v) el.textContent = el.dataset.full.slice(0, Math.round(v.type * el.dataset.full.length));
    if ("count" in v) {
      const n = Math.round(v.count);
      el.textContent = el.dataset.comma === "1" ? n.toLocaleString("en-GB") : String(n);
    }
    if ("spin" in v) spins.push([el, v.spin]);
  }
  // Objects draw last, and only while their scene is on screen.
  for (const [el, angle] of spins) if (STAGE && Number(el.closest(".scene").style.opacity) > 0) STAGE(el.dataset.slug, angle, el);
  document.getAnimations().forEach((a) => {
    a.pause();
    a.currentTime = Math.max(0, t - S["s-fits"].a - 0.4) * 1000;
  });
}
const $ = (s) => document.querySelector(s);
const $$ = (s) => [...document.querySelectorAll(s)];
const RISE = { o: [0, 1], y: [40, 0], clip: [[0, 0, 100, 0], [-20, -20, -20, -20]] };
// Swap a "from" layer for a "to" layer: the old value lifts and blurs away, the new one settles.
function swap(sc, show, change) {
  const a = S[sc].a, root = `#${sc}`;
  at(`${root} .y0, ${root} .m0`, a + show, 0.6, { o: [0, 1], y: [20, 0] });
  at(`${root} .y0, ${root} .m0`, a + change, 0.4, { o: [1, 0], y: [0, -40], blur: [0, 10] }, { ease: "soft" });
  at(`${root} .y1, ${root} .m1`, a + change + 0.15, 0.7, { o: [0, 1], y: [40, 0], blur: [10, 0] });
}

// ---- chrome: scenes cut in and fade out; the hairline fills across the film
at("#bar", 0, DURATION, { sx: [0, 1] }, { ease: "lin" });
for (const sc of SCENES) {
  at(`#${sc.id}`, sc.a, 0.01, { o: [0, 1] }, { ease: "lin" });
  if (sc.id !== "s-end") at(`#${sc.id}`, sc.b - 0.4, 0.4, { o: [1, 0] }, { ease: "soft" });
  at(`#${sc.id} .sh`, sc.a + 0.15, 0.9, RISE, { stagger: 0.12 });
}
$$(".act").forEach((el) => {
  at(el, +el.dataset.a + 0.3, 0.6, { o: [0, 1] });
  at(el, +el.dataset.b - 0.4, 0.4, { o: [1, 0] }, { ease: "soft" });
});
at("#who", S["s-orca"].a + 0.4, 0.8, { o: [0, 1] });
at("#who", S["s-end"].a, 0.5, { o: [1, 0] });

// ---- open
{
  const a = S["s-open"].a, b = S["s-open"].b;
  at("#o-cred", a + 0.3, 0.9, { o: [0, 1], y: [10, 0] });
  at(".ow", a + 0.7, 0.9, RISE, { stagger: 0.09 });
  at("#o-line", a + 1.8, 1.1, { sx: [0, 1] }, { ease: "inout" });
  at(["#o-cred", "#o-h", "#o-line"], b - 0.7, 0.7, { y: [0, -50], blur: [0, 10] }, { ease: "soft", stagger: 0.04 });
}

// ---- hero shots: the word rises, the object turns in front of it
for (const [sc, word, obj, say, from, to] of [["s-orca", "#or-word", "#or-obj", "#or-say", -1.2, 1.3], ["s-plat", "#pl-word", "#pl-obj", "#pl-say", 1.0, -1.2]]) {
  const a = S[sc].a, b = S[sc].b;
  at(word, a + 0.1, 1.2, { o: [0, 1], y: [120, 0], clip: [[0, 0, 100, 0], [-20, -20, -20, -20]] });
  at(word, a + 1.3, b - a - 1.3, { s: [1, 1.06] }, { ease: "lin" });
  at(obj, a + 0.5, 1.4, { o: [0, 1], y: [160, 0] });
  at(obj, a, b - a, { spin: [from, to] }, { ease: "lin" });
  at(say, a + 1.6, 0.9, { o: [0, 1], y: [16, 0] });
}

// ---- ask: captions on the left, the window turning toward us
{
  const a = S["s-ask"].a, caps = $$(".ac"), beats = [0.2, 3.0, 6.0, 8.8];
  caps.forEach((c, i) => {
    at(c, a + beats[i], 0.8, RISE);
    if (i < caps.length - 1) at(c, a + beats[i + 1] - 0.35, 0.4, { o: [1, 0], y: [0, -30], blur: [0, 8] }, { ease: "soft" });
  });
  at("#win", a, 1.6, { o: [0, 1], x: [160, 0], y: [0, 0], ry: [-30, -20], rx: [8, 6], s: [0.94, 1] });
  at("#win", a + 1.6, 7.2, { ry: [-20, -12], rx: [6, 4] }, { ease: "soft" });
  at("#win", a + 8.8, 2.4, { ry: [-12, 0], rx: [4, 0], s: [1, 1.12], x: [0, -30], y: [0, -40] }, { ease: "inout" });
  at("#ask-note", a + 1.0, 0.8, { o: [0, 1] });
  at("#q", a + 0.3, 0.3, { o: [0, 1] });
  at("#q", a + 0.6, 1.6, { type: [0, 1] }, { ease: "lin" });
  $$(".st").forEach((li, i) => {
    const s = a + 3.2 + i * 0.6;
    at(li, s, 0.4, { o: [0, 1], y: [10, 0] });
    at(li.querySelector(".ring"), s, 0.55, { r: [0, 330], o: [1, 1] }, { ease: "lin" });
    at(li.querySelector(".ring"), s + 0.55, 0.01, { o: [1, 0] }, { ease: "lin" });
    at(li.querySelector(".fill"), s + 0.52, 0.25, { o: [0, 1], s: [0.6, 1] });
  });
  at("#ans", a + 6.2, 1.0, { o: [1, 1], clip: [[0, 100, 0, 0], [0, -2, 0, 0]] }, { ease: "inout" });
  at("#tbl", a + 6.6, 0.6, { o: [0, 1], y: [12, 0] });
  at(".tr", a + 6.8, 0.5, { o: [0, 1], y: [10, 0] }, { stagger: 0.16 });
  at("#art", a + 9.0, 0.7, { o: [0, 1], y: [14, 0], s: [0.96, 1] });
  at("#stamp", a + 9.4, 0.6, { o: [0, 1] });
  at("#hot", a + 10.6, 0.5, { o: [0, 1], s: [1.25, 1] });
}

// ---- truths
{
  for (const id of ["s-t1", "s-t2", "s-t3", "s-t4"]) at(`#${id} .tl`, S[id].a + 0.1, 0.9, RISE);
  const a1 = S["s-t1"].a;
  at(".t1p", a1 + 0.5, 0.8, { o: [0, 1], s: [0.9, 1] }, { stagger: 0.12 });
  at(".t1l", a1 + 0.9, 1.0, { draw: [1, 0] }, { stagger: 0.12, ease: "inout" });
  at("#t1-hub", a1 + 0.3, 0.9, { o: [0, 1], s: [0.7, 1] });
  at("#t1-hub", a1 + 2.0, 0.4, { s: [1, 1.14] }, { ease: "out2" });
  at("#t1-hub", a1 + 2.4, 0.5, { s: [1.14, 1] }, { ease: "soft" });
  at("#t1-ping", a1, 0.01, { o: [0, 0] }, { ease: "lin" });
  at("#t1-ping", a1 + 2.0, 1.0, { o: [1, 0], s: [0.5, 1.7] }, { ease: "out2" });
  const a2 = S["s-t2"].a;
  at("#mt2h", a2 + 0.4, 0.5, { o: [0, 1] });
  at(".mr", a2 + 0.5, 0.5, { o: [0, 1], y: [12, 0] }, { stagger: 0.09 });
  at("#scan", a2, 0.01, { o: [0, 0] }, { ease: "lin" });
  at("#scan", a2 + 1.2, 0.01, { o: [0, 1] }, { ease: "lin" });
  at("#scan", a2 + 1.2, 1.0, { y: [0, 330] }, { ease: "soft" });
  at("#scan", a2 + 2.2, 0.3, { o: [1, 0] });
  $$(".mr").forEach((row, i) => {
    const s = a2 + 1.3 + i * 0.18;
    at(row.querySelector("td.m i"), s, 0.35, { sx: [0, 1] });
    at(row.querySelector("td.m .v"), s, 0.2, { o: [1, 0] });
  });
  at("#badge", a2 + 2.2, 0.6, { o: [0, 1], y: [10, 0] });
  const a3 = S["s-t3"].a;
  at(".t3", a3 + 0.5, 0.8, { o: [0, 1], y: [40, 0] }, { stagger: 0.18 });
  at("#t3-prog", a3 + 1.0, 1.8, { sx: [0, 1] }, { ease: "soft" });
  at("#t3-hand", a3 + 0.9, 2.0, { r: [0, 360] }, { ease: "inout" });
  at(".t3-bar", a3 + 1.2, 0.5, { sy: [0, 1] }, { stagger: 0.12 });
  const a4 = S["s-t4"].a;
  at(".nl", a4 + 0.4, 0.9, { draw: [1, 0], o: [0.35, 0.35] }, { stagger: 0.02, ease: "soft" });
  at(".nn", a4 + 0.4, 0.4, { o: [0, 0.25], s: [0.4, 1] }, { stagger: 0.015 });
  at(".nn", a4 + 1.2, 0.35, { o: [0.25, 1] }, { stagger: (i, el) => Number(el.dataset.order) * 0.045 });
  at("#t4-note", a4 + 1.6, 0.8, { o: [0, 1], y: [12, 0] });
}

// ---- adoption: one figure at a time
$$(".sn").forEach((sec) => {
  const sc = S[sec.id], g = sec.querySelector(".giant"), c = sec.querySelector(".cnt");
  at(g, sc.a + 0.05, 0.9, { o: [0, 1], s: [0.9, 1], blur: [16, 0] });
  if (Number(c.dataset.to)) at(c, sc.a + 0.05, 1.2, { count: [0, Number(c.dataset.to)] }, { ease: "out2" });
  at(sec.querySelector(".say"), sc.a + 0.6, 0.7, { o: [0, 1], y: [14, 0] });
  at(g, sc.b - 0.45, 0.45, { s: [1, 1.04] }, { ease: "soft" });
});

// ---- stack: the layers under every answer, pulled apart
{
  const a = S["s-stack"].a, slabs = $$(".slab");
  at("#br0", a + 0.1, 0.9, RISE);
  at("#br0", a + 2.2, 0.01, { o: [1, 0] }, { ease: "lin" });
  at("#br1", a + 2.2, 0.01, { o: [0, 1] }, { ease: "lin" });
  slabs.forEach((sl, i) => {
    at(sl, a + 0.3 + i * 0.12, 0.8, { o: [0, 1], z: [0, 0] });
    at(sl, a + 1.3, 1.7, { z: [0, i * 120] }, { ease: "inout" });
  });
  at(".slabel", a + 2.6, 0.7, { o: [0, 1], x: [-20, 0] }, { stagger: 0.12 });
  at("#stack3d", a + 4.6, 1.4, { s: [1, 1.5], y: [0, -120] }, { ease: "inout" });
  at(".slabel", a + 4.7, 0.5, { o: [1, 0] }, { ease: "soft" });
}

// ---- runs: a hundred runs, the failures filling in
{
  const a = S["s-runs"].a;
  swap("s-runs", 0.4, 2.3);
  at(".grid100 i.g1", a + 0.3, 0.5, { o: [0, 1], s: [0.5, 1] }, { stagger: (i) => ((i % 10) + Math.floor(i / 10)) * 0.025 });
  at(".grid100 i.f b", a, 0.01, { s: [0, 0] }, { ease: "lin" });
  at(".grid100 i.f b", a + 2.4, 0.45, { s: [0, 1] }, { stagger: (i) => i * 0.018, ease: "back" });
}

// ---- code: hand-made pieces snap into one grid
{
  const a = S["s-code"].a;
  swap("s-code", 0.4, 2.0);
  $$(".blocks i").forEach((el, i) => {
    const d = el.dataset;
    at(el, a + 0.2 + (i % 17) * 0.012, 0.5, { o: [0, 1], x: [+d.x0, +d.x0], y: [+d.y0, +d.y0], r: [+d.r0, +d.r0] });
    at(el, a + 1.9 + (i % 23) * 0.022, 0.9, { x: [+d.x0, +d.x1], y: [+d.y0, +d.y1], r: [+d.r0, 0] }, { ease: "inout" });
  });
  at("#code-note", a + 2.9, 0.8, { o: [0, 1], y: [14, 0] });
}

// ---- review: every commit on the line gets its check
{
  const a = S["s-review"].a;
  swap("s-review", 0.4, 2.2);
  at("#git-rail", a + 0.3, 1.0, { sx: [0, 1] }, { ease: "inout" });
  at(".gc", a + 0.5, 0.4, { o: [0, 1], s: [0.5, 1] }, { stagger: 0.04 });
  at(".gc b.ok", a + 0.9, 0.3, { s: [0, 1] }, { stagger: 0.04, ease: "back" });
  at(".gc b.late", a, 0.01, { s: [0, 0] }, { ease: "lin" });
  at(".gc b.late", a + 2.4, 0.35, { s: [0, 1] }, { stagger: 0.06, ease: "back" });
}

// ---- scale
{
  const a = S["s-books"].a;
  at(".spines i", a + 0.4, 0.6, { sy: [0, 1] }, { stagger: (i) => i * 0.008, ease: "out2" });
  const t = S["s-ticker"].a;
  at("#tick", t + 0.05, 2.2, { count: [0, Number($("#tick").dataset.to)] }, { ease: "out2" });
  at("#tick-say", t + 0.5, 0.7, { o: [0, 1], y: [14, 0] });
  $$(".pr").forEach((ring, i) => at(ring, t + 0.3 + i * 1.0, 1.4, { o: [1, 0], s: [0.3, 1.3] }, { ease: "out2" }));
  at(".pr", t, 0.01, { o: [0, 0] }, { ease: "lin" });
  at("#pb", t + 0.2, 0.4, { s: [0, 1] }, { ease: "back" });
  const p = S["s-people"].a, from = +$("#ppl").dataset.from, to = +$("#ppl").dataset.to;
  at("#ppl", p, 0.6, { count: [from, from] }, { ease: "lin" });
  at("#ppl", p + 1.5, 1.4, { count: [from, to] }, { ease: "soft" });
  at("#ppl-say", p + 0.4, 0.7, { o: [0, 1], y: [14, 0] });
  at(".dots160 i", p + 0.2, 0.4, { o: [0, 0.14] }, { stagger: (i) => i * 0.003 });
  at(".dots160 i.d0", p + 0.6, 0.3, { o: [0.14, 1] }, { stagger: (i) => i * 0.02 });
  at(".dots160 i.d1", p + 1.5, 0.25, { o: [0.14, 1] }, { stagger: (i) => i * 0.009 });
  swap("s-people", 0.4, 1.5);
}

// ---- savings, then the sum
{
  const a = S["s-save"].a;
  $$(".mrow").forEach((row, i) => {
    const s = a + 0.7 + i * 0.6;
    at(row, s, 0.5, { o: [0, 1], y: [16, 0] });
    at(row.querySelector(".strike"), s + 0.35, 0.45, { sx: [0, 1] }, { ease: "inout" });
    at(row.querySelector(".stop"), s + 0.5, 0.4, { o: [1, 0.5] });
    at([row.querySelector(".arrow"), row.querySelector(".inst2")], s + 0.6, 0.5, { o: [0, 1], x: [-24, 0] }, { stagger: 0.08 });
  });
  at("#close", S["s-close"].a + 0.1, 1.0, { o: [0, 1], s: [0.92, 1], blur: [12, 0] });
}

// ---- the whole drawing
at("#dia", S["s-fits"].a, S["s-fits"].b - S["s-fits"].a, { s: [0.96, 1.04] }, { ease: "lin" });

// ---- end: both objects, the name
{
  const a = S["s-end"].a;
  at(["#e-o1", "#e-o2"], a + 0.1, 1.2, { o: [0, 1], y: [80, 0] }, { stagger: 0.15 });
  at("#e-o1", a, DURATION - a, { spin: [-0.8, 0.6] }, { ease: "lin" });
  at("#e-o2", a, DURATION - a, { spin: [0.8, -0.6] }, { ease: "lin" });
  at(["#e-l1", "#e-l2"], a + 0.9, 0.6, { o: [0, 1] }, { stagger: 0.1 });
  at("#e-name", a + 1.2, 1.0, RISE);
  at("#e-role", a + 1.7, 0.8, { o: [0, 1], y: [14, 0] });
  at("#e-url", a + 2.1, 0.8, { o: [0, 1], y: [14, 0] });
}

window.render = render;
window.DURATION = DURATION;
window.ready = (async () => {
  await document.fonts.ready;
  try {
    STAGE = await window.stageObjects(900);
  } catch (e) {
    console.error("objects unavailable", e);
  }
  render(0);
})();
</script>
