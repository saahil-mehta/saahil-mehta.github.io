---
import Icon from "./Icon.astro";
import { profile } from "../lib/profile";

interface Props {
  path: string;
}
const { path } = Astro.props;
const { person } = profile;

const items = [
  { href: "/showreel", label: "Showreel" },
  { href: "/projects", label: "Work" },
  { href: "/experience", label: "Experience" },
  { href: "/volunteering", label: "Community" },
  { href: "/education", label: "Education" },
  { href: "/github", label: "Activity" },
  { href: "/resume", label: "Resume" },
];
---

<header class="topline" id="main-header">
  <div class="wrap">
    <a href="/" class="brand" aria-label={`${person.name}, home`}>
      <span>{person.name}</span>
      <span class="role">{person.title}</span>
    </a>
    <nav class="site-nav" id="navigation-menu" aria-label="Primary">
      {items.map((item) => <a class="draw" href={item.href} aria-current={item.href === path ? "page" : undefined}>{item.label}</a>)}
      <a class="cta draw" href={person.links.calendly} target="_blank" rel="noopener">Book a call</a>
    </nav>
    <div class="topline-tools">
      <button id="theme-toggle" class="icon-btn" type="button" aria-label="Switch colour scheme">
        <Icon name="moon" class="icon-moon" size={18} />
        <Icon name="sun" class="icon-sun" size={18} />
      </button>
      <button id="toggle-navigation-menu" class="icon-btn" type="button" aria-expanded="false" aria-controls="navigation-menu" aria-label="Toggle navigation menu">
        <Icon name="menu" class="icon-menu" size={20} />
        <Icon name="close" class="icon-close" size={20} />
      </button>
    </div>
  </div>
</header>
