---
import Icon from "./Icon.astro";
import { profile } from "../lib/profile";

interface Props {
  path: string;
}
const { path } = Astro.props;
const { person } = profile;

const items = [
  { href: "/", label: "Status" },
  { href: "/projects", label: "Systems" },
  { href: "/experience", label: "Experience" },
  { href: "/volunteering", label: "Community" },
  { href: "/education", label: "Education" },
  { href: "/github", label: "Activity" },
  { href: "/resume", label: "Resume" },
];
---

<header class="site-header" id="main-header">
  <div class="container">
    <a href="/" class="brand" aria-label={`${person.name}, home`}>
      <img src="/logo-52.webp" alt="" width="26" height="26" decoding="async" />
      <span>{person.name}</span>
    </a>
    <nav class="site-nav" id="navigation-menu" aria-label="Primary">
      {
        items.map((item) => (
          <a href={item.href} aria-current={item.href === path ? "page" : undefined}>
            {item.label}
            {item.href === path && <span class="nav-indicator" aria-hidden="true" />}
          </a>
        ))
      }
    </nav>
    <div class="header-tools">
      <button id="theme-toggle" class="icon-button" type="button" aria-label="Switch to dark theme">
        <Icon name="sun" class="sun-icon" />
        <Icon name="moon" class="moon-icon" />
      </button>
      <button id="toggle-navigation-menu" class="icon-button" type="button" aria-expanded="false" aria-controls="navigation-menu" aria-label="Toggle navigation menu">
        <Icon name="menu" class="icon-menu" />
        <Icon name="close" class="icon-close" />
      </button>
    </div>
  </div>
</header>
