---
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";
import { profile } from "../lib/profile";

const { person, site, projects, roles } = profile;
const stat = (needle: string) => site.stats.find((s) => s.label.includes(needle));
const people = stat("employees")?.value ?? 501;
const reports = stat("reports")?.value ?? 6;
const orca = projects.find((p) => p.name === "Orca");
const firstYear = roles[roles.length - 1].start.slice(0, 4);
---

<section class="box sheet container" aria-labelledby="hero-heading">
  <div class="hero">
    <div class="hero-copy">
      <h1 id="hero-heading" class="headline">
        <span class="ink-night">I run the platform.</span>
        <span class="ink-red" data-ink="red">I ship the systems.</span>
        <span class="ink-green" data-ink="green">For {people.toLocaleString("en-GB")} people.</span>
      </h1>
      <p class="hero-line">
        {person.title} at <a href="https://www.southpole.com" target="_blank" rel="noopener">South Pole</a>. I lead a team of {reports}, own the data platform, the marts and the reporting stack, and still commit code daily. The goods below are what is on the shelf.
      </p>
      <div class="hero-actions">
        <a class="btn fill" href="/projects">Browse the systems <Icon name="arrow-right" size={16} /></a>
        <a class="btn" href={person.links.calendly} target="_blank" rel="noopener noreferrer">Book a call <Icon name="calendar" size={16} /></a>
      </div>
    </div>
    <aside class="hero-card" aria-label="Operator card">
      <div class="label-row">
        <span class="label">Operator</span>
        <span class="label">London · est. {firstYear}</span>
      </div>
      <img src="/portrait-halftone.png" alt={`Halftone portrait of ${person.name}`} width="300" height="300" decoding="async" fetchpriority="high" />
      <div class="serial">
        <span>No. {roles[0].start.replace("-", "")}</span>
        <span>{person.title}</span>
      </div>
    </aside>
  </div>
  <div class="facts">
    <div class="fact">
      <Mark name="bars" size={28} ink="night" />
      <div>
        <strong class="fact-title">Team of {reports}</strong>
        <span class="fact-copy">Analytics engineers, analysts and data engineers, serving {people.toLocaleString("en-GB")} people.</span>
      </div>
    </div>
    <div class="fact" data-ink="red">
      <Mark name="chevron" size={28} ink="red" />
      <div>
        <strong class="fact-title">Strategy adopted by ExCo</strong>
        <span class="fact-copy">The Data Foundation Plan: seven workstreams to 2028, ~295k EUR a year of direct savings.</span>
      </div>
    </div>
    <div class="fact" data-ink="green">
      <Mark name="ring" size={28} ink="green" />
      <div>
        <strong class="fact-title">Orca · {orca?.metric.value}</strong>
        <span class="fact-copy">{orca?.metric.label}; over a quarter of the company querying data through it within three weeks of 2.0.</span>
      </div>
    </div>
  </div>
</section>
