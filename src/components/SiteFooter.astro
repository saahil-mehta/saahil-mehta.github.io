---
import { profile } from "../lib/profile";
import { buildTimestamp } from "../lib/dates";
const { person, site } = profile;
---

<footer class="site-footer container">
  <span>Built by me, and Claude :)</span>
  <span class="mono">Last deploy {buildTimestamp()}</span>
  <span>
    <a href={person.links.github} target="_blank" rel="noopener">GitHub</a> ·
    <a href={person.links.linkedin} target="_blank" rel="noopener">LinkedIn</a> ·
    <a href={`mailto:${person.email}`}>Email</a> ·
    <a href={`${site.url}/llms.txt`}>llms.txt</a>
  </span>
</footer>
