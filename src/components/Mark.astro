---
// Office marks: one geometric construction per system on a 64-unit grid, filled shapes only.
// The same eight forms appear at every size, from the masthead to a kiosk cell.
interface Props {
  name: "ring" | "arch" | "chevron" | "bars" | "keyhole" | "quarter" | "grid" | "half";
  size?: number;
  ink?: "night" | "red" | "green";
  class?: string;
}
const { name, size = 64, ink = "night", class: className } = Astro.props;
const colour = { night: "var(--night)", red: "var(--red)", green: "var(--green)" }[ink];
const SHAPES: Record<Props["name"], string> = {
  ring: '<path fill-rule="evenodd" d="M32 4a28 28 0 1 1 0 56 28 28 0 0 1 0-56Zm0 14a14 14 0 1 0 0 28 14 14 0 0 0 0-28Z"/>',
  arch: '<path d="M10 60V32a22 22 0 0 1 44 0v28H40V32a8 8 0 0 0-16 0v28Z"/>',
  chevron: '<path d="M4 44 32 16l28 28-9 9-19-19-19 19Z"/>',
  bars: '<path d="M6 8h52v12H6zm0 18h52v12H6zm0 18h38v12H6z"/>',
  keyhole: '<path fill-rule="evenodd" d="M32 4a20 20 0 0 1 10 37.3L46 60H18l4-18.7A20 20 0 0 1 32 4Z"/>',
  quarter: '<path d="M4 60V32A28 28 0 0 1 32 4h28v28H32v28Z"/>',
  grid: '<path d="M4 4h26v26H4zm30 0h26v26H34zM4 34h26v26H4zm30 0h26v26H34z"/>',
  half: '<path d="M4 34a28 28 0 0 1 56 0ZM4 42h56v14H4z"/>',
};
---

<svg class={className} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" fill={colour} set:html={SHAPES[name]} />
