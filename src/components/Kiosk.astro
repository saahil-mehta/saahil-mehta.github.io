---
import Good from "./Good.astro";
import type { Project } from "../lib/profile";

interface Props {
  projects: Project[];
  detail?: boolean;
  featured?: string;
}
const { projects, detail = false, featured = "Orca" } = Astro.props;
const ranked = projects.map((p) => ({ p, rank: (p.name === featured ? 2 : 1) as 1 | 2 }));

// The shelf runs 4, 3, 2 and 1 columns across the breakpoints. A short last row would
// show the ink behind the grid, so one empty slot spans the free columns of that row.
// Its span per column count travels as custom properties; CSS hides it at the widths
// where the row is already full and at the single column. The featured good spans two
// columns everywhere except the single column.
const COLUMNS = [4, 3, 2] as const;
const cells = ranked.reduce((n, { rank }) => n + (rank === 2 ? 2 : 1), 0);
const free = Object.fromEntries(COLUMNS.map((c) => [c, (c - (cells % c)) % c])) as Record<(typeof COLUMNS)[number], number>;
const slotStyle = COLUMNS.map((c) => `--span-${c}: ${Math.max(free[c], 1)}`).join("; ");
const slotHidden = COLUMNS.filter((c) => free[c] === 0).map((c) => `hide-${c}`);
---

<ol class="kiosk">
  {ranked.map(({ p, rank }) => <Good project={p} rank={rank} detail={detail} />)}
  {Object.values(free).some((n) => n > 0) && (
    <li class:list={["good", "good-empty", slotHidden]} style={slotStyle} aria-hidden="true">
      <span class="label">Shelf space</span>
    </li>
  )}
</ol>
