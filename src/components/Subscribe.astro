---
import Icon from "./Icon.astro";
import { profile } from "../lib/profile";
const { person } = profile;
---

<section class="subscribe container" aria-labelledby="subscribe-heading">
  <div>
    <h2 id="subscribe-heading">Subscribe to updates</h2>
    <p>Talk about enterprise AI, data platforms, or leading a data team. A 30-minute call is the fastest route; email works too.</p>
  </div>
  <div class="actions">
    <button class="button" type="button" data-copy={person.email} aria-label={`Copy email address ${person.email}`}>
      <Icon name="copy" size={16} />
      <span class="when-idle">{person.email}</span>
      <span class="when-copied">Copied to clipboard</span>
    </button>
    <a class="button primary" href={person.links.calendly} target="_blank" rel="noopener noreferrer">
      <Icon name="calendar" size={16} />
      <span>Book a call</span>
    </a>
  </div>
  <p class="integrations">
    <span>Integrations</span>
    <a href="/resume.json">resume.json</a>
    <a href="/cv.md">cv.md</a>
    <a href="/llms.txt">llms.txt</a>
    <a href="/Saahil-Mehta-Resume.pdf">resume.pdf</a>
  </p>
</section>
