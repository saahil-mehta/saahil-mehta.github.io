---
import Icon from "./Icon.astro";
import { profile } from "../lib/profile";
const { person, summaries } = profile;
const line = summaries.site_bio.split(/\n\s*\n/)[0];
---

<section class="identity container" aria-label="Operator">
  <picture>
    <source type="image/webp" srcset="/profile-144.webp 2x, /profile-216.webp 3x" />
    <img src="/profile-144.jpg" srcset="/profile-144.jpg 2x, /profile-216.jpg 3x" alt={`Portrait of ${person.name}`} width="72" height="72" fetchpriority="high" decoding="async" />
  </picture>
  <div>
    <h2>{person.name}</h2>
    <p class="role">{person.title} at <a href="https://www.southpole.com" target="_blank" rel="noopener">South Pole</a></p>
    <p class="identity-line">{line}</p>
  </div>
  <div class="actions">
    <button class="button" type="button" data-copy={person.email} aria-label={`Copy email address ${person.email}`}>
      <Icon name="mail" size={16} />
      <span class="when-idle">Email</span>
      <span class="when-copied">Copied</span>
    </button>
    <a class="button" href={person.links.linkedin} target="_blank" rel="noopener">
      <Icon name="linkedin" size={16} />
      <span>LinkedIn</span>
    </a>
    <a class="button primary" href={person.links.calendly} target="_blank" rel="noopener noreferrer">
      <Icon name="calendar" size={16} />
      <span>Book a call</span>
    </a>
  </div>
</section>
