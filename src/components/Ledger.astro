---
import Icon from "./Icon.astro";
import { profile } from "../lib/profile";
const { person, roles, site } = profile;
const current = roles[0];
const stat = (needle: string) => site.stats.find((s) => s.label.includes(needle));
const people = stat("employees");
const reports = stat("reports");
const savings = stat("savings");
---

<div class="ledger">
  <div class="ledger-graph" id="github-contributions" data-username="saahil-mehta">
    <p class="loading">Fetching the last twelve months of commits</p>
    <noscript>
      <p class="contrib-note">The ledger needs JavaScript. The commits themselves are on <a href={person.links.github}>GitHub</a>.</p>
    </noscript>
  </div>
  <ul class="ledger-facts" aria-label="Office facts">
    <li><span>Role</span><span class="fact-value">{current.title}</span></li>
    <li><span>Direct reports</span><span class="fact-value">{reports?.value ?? 6}</span></li>
    <li><span>People served</span><span class="fact-value">{people?.value.toLocaleString("en-GB") ?? "501"}</span></li>
    <li><span>Data strategy</span><span class="fact-value">Adopted by ExCo</span></li>
    <li><span>Direct savings in the plan</span><span class="fact-value">{savings ? `${savings.prefix}${savings.value}${savings.suffix}` : "~295k EUR/yr"}</span></li>
    <li><span>Platform incidents</span><span class="fact-value">Every 2 days to monthly</span></li>
    <li><span>Full ledger</span><a class="fact-value" href="/github" style="text-decoration:none;display:inline-flex;align-items:center;gap:.375rem">Activity <Icon name="arrow-right" size={14} /></a></li>
  </ul>
</div>
