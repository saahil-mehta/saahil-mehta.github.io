---
// A reconstruction of the Orca chat, drawn in the site's inks with invented data from
// site.showreel.orca.demo. Without JavaScript, or under reduced motion, it shows the finished
// exchange. With script it plays once when it comes into view: the question lands, each step
// resolves in turn, then the answer, its table, the deck and the freshness stamp.
import Icon from "./Icon.astro";
import { profile } from "../lib/profile";

const demo = profile.site.showreel!.orca.demo;
const after = 1.2 + demo.steps.length * 0.75;
---

<figure class="orca-demo" data-demo tabindex="-1" style={`--after:${after}s`}>
  <div class="demo-window" role="img" aria-label={`Orca answering: ${demo.question}`}>
    <div class="demo-bar" aria-hidden="true">
      <span class="logo orca-mark" style="--logo:url(/logos/orca.png);--ar:1.049"></span>
      <span class="demo-name">Orca</span>
      <span class="demo-chip credit">New chat</span>
      <span class="demo-dots"><i></i><i></i><i></i></span>
    </div>
    <div class="demo-convo" aria-hidden="true">
      <p class="demo-you">{demo.question}</p>
      <ol class="demo-steps">
        {
          demo.steps.map((s, i) => (
            <li style={`--d:${1.2 + i * 0.75}s`}>
              <span class="demo-dot">
                <Icon name="check" size={12} />
              </span>
              <span>{s}</span>
            </li>
          ))
        }
      </ol>
      <div class="demo-reply">
        <p>{demo.answer}</p>
        <table>
          <thead>
            <tr>{demo.table.head.map((h) => <th>{h}</th>)}</tr>
          </thead>
          <tbody>
            {
              demo.table.rows.map((r, i) => (
                <tr style={`--r:${i}`}>
                  {r.map((c) => (
                    <td>{c}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
        <div class="demo-artefact">
          <span class="demo-thumb"><Icon name="slides" size={18} /></span>
          <span class="demo-art-copy">
            <span class="demo-art-name">{demo.artefact.name}</span>
            <span class="demo-art-meta">{demo.artefact.meta}</span>
          </span>
          <span class="demo-open">Open</span>
        </div>
        <p class="demo-stamp credit">{demo.stamp}</p>
      </div>
    </div>
    <div class="demo-composer" aria-hidden="true">
      <Icon name="plus" size={16} />
      <span>Ask Orca</span>
      <span class="demo-send"><Icon name="arrow-up" size={14} /></span>
    </div>
  </div>
  <figcaption>
    <span class="demo-note">{demo.note}</span>
    <button class="demo-replay credit" type="button" hidden><Icon name="replay" size={14} /> Play again</button>
  </figcaption>
</figure>
