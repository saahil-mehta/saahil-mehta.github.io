---
import ComponentRow from "./ComponentRow.astro";
import type { Project } from "../lib/profile";

interface Props {
  projects: Project[];
  detail?: boolean;
}
const { projects, detail = false } = Astro.props;
---

<div class="components-head" aria-hidden="true">
  <span class="label">Component</span>
  <span class="label">Time in production, last 36 months</span>
  <span class="label" style="text-align:right">Headline figure</span>
  <span class="label">Status</span>
</div>
<ol class="components">
  {projects.map((p, i) => <ComponentRow project={p} index={i} detail={detail} />)}
</ol>
