---
import Icon from "./Icon.astro";
import { profile } from "../lib/profile";
import { buildTimestamp } from "../lib/dates";

interface Props {
  heading?: string;
}
const { heading = "All systems operational" } = Astro.props;
const live = profile.projects.filter((p) => p.status === "live").length;
const building = profile.projects.filter((p) => p.status === "in_progress").length;
const people = profile.site.stats.find((s) => s.label.includes("employees"))?.value ?? 501;
---

<section class="banner" aria-labelledby="status-heading">
  <div class="container">
    <Icon name="check-circle" size={32} class="banner-icon" />
    <div>
      <h1 id="status-heading">{heading}</h1>
      <p class="banner-sub">{live} operational · {building} in build · {people.toLocaleString("en-GB")} people served · one operator</p>
    </div>
    <p class="banner-meta">
      Last checked
      <strong>{buildTimestamp()}</strong>
    </p>
  </div>
</section>
