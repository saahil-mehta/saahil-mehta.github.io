---
import type { Role } from "../lib/profile";
import { fmtMonth } from "../lib/profile";

interface Props {
  role: Role;
  index: number;
}
const { role, index } = Astro.props;
---

<li class="timeline-item" data-reveal style={`--stagger:${Math.min(index, 7)}`}>
  <span class="timeline-dot" aria-hidden="true"></span>
  <div class="timeline-header">
    <span class="timeline-org">{role.org}{role.unit && ` · ${role.unit}`}</span>
    <span class="timeline-role">{role.title}</span>
    <span class="timeline-dates">
      <time datetime={role.start}>{fmtMonth(role.start)}</time> – {role.end === "present" ? "Present" : <time datetime={role.end}>{fmtMonth(role.end)}</time>}
    </span>
  </div>
  <div class="timeline-meta">{role.location}</div>
  <p class="timeline-desc">{role.site_desc}</p>
  <div class="timeline-tags">{role.tags.map((t) => <span>{t}</span>)}</div>
</li>
