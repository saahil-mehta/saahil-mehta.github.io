---
import Base from "../layouts/Base.astro";
import Counter from "../components/Counter.astro";
import { profile } from "../lib/profile";
import { pageTitle, breadcrumbJsonLd } from "../lib/seo";

const meta = profile.site.pages.education;
const path = "/education";
---

<Base title={pageTitle(meta.title)} description={meta.description} path={path} jsonLd={[breadcrumbJsonLd(meta.title, path)]}>
  <section class="box sheet container page-head">
    <div>
      <h1>Education</h1>
      <p>Computer science, mathematics and business analytics, in that order.</p>
    </div>
  </section>
  <section class="box section container" aria-label="Degrees">
    <ol class="tickets">
      {
        profile.education.map((e) => (
          <li class="ticket shift">
            <div class="ticket-stub">
              <span class="ticket-serial">{e.years ?? "Degree"}</span>
              <span class="label">{e.location}</span>
            </div>
            <div class="ticket-body">
              <div>
                <h2 class="ticket-title">{e.degree}</h2>
                <p class="org">{e.org}</p>
              </div>
              <p class="dates">{e.grade}</p>
              <p class="desc">{e.desc}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
  <Counter />
</Base>
