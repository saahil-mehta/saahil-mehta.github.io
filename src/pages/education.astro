---
import Base from "../layouts/Base.astro";
import Beat from "../components/Beat.astro";
import CreditRow from "../components/CreditRow.astro";
import EndCard from "../components/EndCard.astro";
import { profile } from "../lib/profile";
import { pageTitle, breadcrumbJsonLd } from "../lib/seo";

const { site, education } = profile;
const meta = site.pages.education;
---

<Base title={pageTitle(meta.title)} description={meta.description} path="/education" jsonLd={[breadcrumbJsonLd(meta.title, "/education")]}>
  <Beat id="education" title="Education" lede="Three degrees, from a diploma in Mumbai to a distinction in Glasgow." level={1}>
    <ol class="credits">
      {education.map((e) => <CreditRow level={2} when={e.years ?? ""} title={e.degree} org={`${e.org} · ${e.location} · ${e.grade}`} line={e.desc} />)}
    </ol>
  </Beat>
  <EndCard />
</Base>
