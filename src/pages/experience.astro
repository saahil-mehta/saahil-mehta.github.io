---
import Base from "../layouts/Base.astro";
import Beat from "../components/Beat.astro";
import CreditRow from "../components/CreditRow.astro";
import EndCard from "../components/EndCard.astro";
import { profile } from "../lib/profile";
import { fmtMonth } from "../lib/dates";
import { pageTitle, breadcrumbJsonLd } from "../lib/seo";

const { site, roles } = profile;
const meta = site.pages.experience;
const when = (start: string, end: string) => `${fmtMonth(start)} to ${end === "present" ? "present" : fmtMonth(end)}`;
---

<Base title={pageTitle(meta.title)} description={meta.description} path="/experience" jsonLd={[breadcrumbJsonLd(meta.title, "/experience")]}>
  <Beat id="experience" title="Experience" lede={site.narrative.ledes.experience} level={1}>
    <ol class="credits">
      {roles.map((r) => <CreditRow level={2} when={when(r.start, r.end)} title={r.title} org={`${r.org}${r.unit ? `, ${r.unit}` : ""} · ${r.location}`} line={r.site_desc} bullets={r.cv_bullets} />)}
    </ol>
  </Beat>
  <EndCard />
</Base>
