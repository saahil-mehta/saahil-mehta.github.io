---
import Base from "../layouts/Base.astro";
import ReleaseRow from "../components/ReleaseRow.astro";
import Subscribe from "../components/Subscribe.astro";
import { profile } from "../lib/profile";
import { pageTitle, breadcrumbJsonLd } from "../lib/seo";

const meta = profile.site.pages.experience;
const path = "/experience";
---

<Base title={pageTitle(meta.title)} description={meta.description} path={path} jsonLd={[breadcrumbJsonLd(meta.title, path)]}>
  <div class="page-head container">
    <h1>Experience</h1>
    <p>Release history, newest first. Each version is a role; the notes under it are what shipped.</p>
  </div>
  <section class="section container" aria-label="Roles">
    <ol class="releases">
      {profile.roles.map((r) => <ReleaseRow role={r} bullets={true} level={2} />)}
    </ol>
  </section>
  <Subscribe />
</Base>
