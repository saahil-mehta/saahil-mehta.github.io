---
import Base from "../layouts/Base.astro";
import Ticket from "../components/Ticket.astro";
import Counter from "../components/Counter.astro";
import { profile } from "../lib/profile";
import { pageTitle, breadcrumbJsonLd } from "../lib/seo";

const meta = profile.site.pages.experience;
const path = "/experience";
---

<Base title={pageTitle(meta.title)} description={meta.description} path={path} jsonLd={[breadcrumbJsonLd(meta.title, path)]}>
  <section class="box sheet container page-head">
    <div>
      <h1>Experience</h1>
      <p>A strip of tickets, newest first. Each ticket is a role; the notes under it are what shipped.</p>
    </div>
  </section>
  <section class="box section container" aria-label="Roles">
    <ol class="tickets">
      {profile.roles.map((r) => <Ticket role={r} bullets={true} level={2} />)}
    </ol>
  </section>
  <Counter />
</Base>
