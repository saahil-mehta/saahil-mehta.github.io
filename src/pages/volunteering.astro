---
import Base from "../layouts/Base.astro";
import Beat from "../components/Beat.astro";
import EndCard from "../components/EndCard.astro";
import { profile } from "../lib/profile";
import { pageTitle, breadcrumbJsonLd } from "../lib/seo";

const { site, volunteering } = profile;
const meta = site.pages.volunteering;
---

<Base title={pageTitle(meta.title)} description={meta.description} path="/volunteering" jsonLd={[breadcrumbJsonLd(meta.title, "/volunteering")]}>
  <Beat id="community" title="Community" lede="Mentoring, a museum archive, and a developer programme." level={1}>
    <ol class="credits">
      {
        volunteering.map((v) => (
          <li class="credit-row" data-arrive="fade">
            <span class="credit when" style="--i:0">{v.year}</span>
            <div class="what">
              <h2 class="h3" style="--i:1">{v.link ? <a class="link" href={v.link} target="_blank" rel="noopener">{v.name}</a> : v.name}</h2>
              <p class="org" style="--i:2">{v.venue}</p>
              <p class="line" style="--i:3">{v.challenge}</p>
              {v.details.map((d, i) => (
                <div class="prose" style={`--i:${4 + i}`}>
                  <h3 class="h3" style="font-size:1.0625rem; margin: 1rem 0 0.375rem">{d.title}</h3>
                  {d.paragraphs.map((p) => <p class="dim" set:html={p} />)}
                </div>
              ))}
              {v.outcome && <p class="line" style="--i:8"><strong>Outcome.</strong> {v.outcome}</p>}
              {v.tags.length > 0 && <div class="tags" style="--i:9">{v.tags.map((t) => <span>{t}</span>)}</div>}
            </div>
          </li>
        ))
      }
    </ol>
  </Beat>
  <EndCard />
</Base>
