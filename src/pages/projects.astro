---
import Base from "../layouts/Base.astro";
import Beat from "../components/Beat.astro";
import StillRow from "../components/StillRow.astro";
import EndCard from "../components/EndCard.astro";
import { profile } from "../lib/profile";
import { pageTitle, breadcrumbJsonLd } from "../lib/seo";

const { site, projects } = profile;
const meta = site.pages.projects;
const active = projects.filter((p) => p.status === "live" || p.status === "in_progress");
const retired = projects.filter((p) => p.status === "paused" || p.status === "archived");
---

<Base title={pageTitle(meta.title)} description={meta.description} path="/projects" jsonLd={[breadcrumbJsonLd(meta.title, "/projects")]}>
  <Beat id="work" title="Work" lede={site.narrative.ledes.work} level={1}>
    <ol class="stills">
      {active.map((p, i) => <StillRow project={p} detail index={i} level={2} />)}
    </ol>
  </Beat>
  {
    retired.length > 0 && (
      <Beat id="earlier" title="Earlier" lede="Work that is paused or retired. The ideas carried forward.">
        <ol class="stills">
          {retired.map((p, i) => <StillRow project={p} detail compact index={i + 10} level={3} />)}
        </ol>
      </Beat>
    )
  }
  <EndCard />
</Base>
