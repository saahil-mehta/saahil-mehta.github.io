---
import Base from "../layouts/Base.astro";
import Beat from "../components/Beat.astro";
import CommitField from "../components/CommitField.astro";
import EndCard from "../components/EndCard.astro";
import { profile } from "../lib/profile";
import { pageTitle, breadcrumbJsonLd } from "../lib/seo";

const { site, person } = profile;
const meta = site.pages.github;
---

<Base title={pageTitle(meta.title)} description={meta.description} path="/github" jsonLd={[breadcrumbJsonLd(meta.title, "/github")]}>
  <Beat id="activity" title="Still shipping" lede={site.narrative.ledes.shipping} level={1} more={{ href: person.links.github, label: "GitHub profile" }}>
    <CommitField />
  </Beat>
  <EndCard />
</Base>
