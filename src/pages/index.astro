---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import StatusBanner from "../components/StatusBanner.astro";
import IdentityRow from "../components/IdentityRow.astro";
import ComponentsTable from "../components/ComponentsTable.astro";
import OperatorBlock from "../components/OperatorBlock.astro";
import ReleaseRow from "../components/ReleaseRow.astro";
import Subscribe from "../components/Subscribe.astro";
import { profile } from "../lib/profile";
import { paragraphs } from "../lib/text";
import { pageTitle, profilePageJsonLd } from "../lib/seo";

const { site, summaries, projects, roles } = profile;
const systems = projects.filter((p) => p.status !== "paused" && p.status !== "archived");
const bio = paragraphs(summaries.site_bio).slice(1, 3);
---

<Base title={pageTitle()} description={site.description} path="/" ogType="profile" jsonLd={[profilePageJsonLd()]}>
  <StatusBanner />
  <IdentityRow />

  <section class="section container" aria-labelledby="components-heading">
    <div class="section-head">
      <h2 id="components-heading">Components</h2>
      <span class="label">{systems.length} systems</span>
      <a class="more" href="/projects">All systems <Icon name="arrow-right" size={14} /></a>
    </div>
    <ComponentsTable projects={systems} />
  </section>

  <section class="section container" aria-labelledby="operator-heading">
    <div class="section-head">
      <h2 id="operator-heading">Operator</h2>
      <span class="label">commits, last 12 months</span>
    </div>
    <OperatorBlock />
  </section>

  <section class="section container" aria-labelledby="about-heading">
    <div class="section-head">
      <h2 id="about-heading">About</h2>
    </div>
    <div class="prose" style="padding-top:1.25rem">
      {bio.map((p) => <p set:html={p} />)}
    </div>
  </section>

  <section class="section container" aria-labelledby="history-heading">
    <div class="section-head">
      <h2 id="history-heading">Release history</h2>
      <span class="label">{roles.length} releases</span>
      <a class="more" href="/experience">Full history <Icon name="arrow-right" size={14} /></a>
    </div>
    <ol class="releases">
      {roles.slice(0, 3).map((r) => <ReleaseRow role={r} />)}
    </ol>
  </section>

  <Subscribe />
</Base>
