---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import KioskHero from "../components/KioskHero.astro";
import Kiosk from "../components/Kiosk.astro";
import Ledger from "../components/Ledger.astro";
import Ticket from "../components/Ticket.astro";
import Counter from "../components/Counter.astro";
import { profile } from "../lib/profile";
import { paragraphs } from "../lib/text";
import { pageTitle, profilePageJsonLd } from "../lib/seo";

const { site, summaries, projects, roles } = profile;
const goods = projects.filter((p) => p.status === "live" || p.status === "in_progress");
const bio = paragraphs(summaries.site_bio).slice(2, 4);
---

<Base title={pageTitle()} description={site.description} path="/" ogType="profile" jsonLd={[profilePageJsonLd()]}>
  <KioskHero />

  <section class="box section container" aria-labelledby="shelf-heading">
    <div class="box-head">
      <h2 id="shelf-heading">On the shelf · {goods.length} goods</h2>
      <a class="more" href="/projects">All systems <Icon name="arrow-right" size={14} /></a>
    </div>
    <Kiosk projects={goods} />
  </section>

  <section class="box section container" aria-labelledby="ledger-heading">
    <div class="box-head">
      <h2 id="ledger-heading">Production ledger · commits, last 12 months</h2>
      <a class="more" href="/github">Full ledger <Icon name="arrow-right" size={14} /></a>
    </div>
    <Ledger />
  </section>

  <section class="box section container" aria-labelledby="notes-heading">
    <div class="box-head">
      <h2 id="notes-heading">Office notes</h2>
    </div>
    <div class="prose" style="padding:1.5rem 2rem 1.75rem">
      {bio.map((p) => <p set:html={p} />)}
    </div>
  </section>

  <section class="box section container" aria-labelledby="tickets-heading">
    <div class="box-head">
      <h2 id="tickets-heading">Tickets · {roles.length} roles</h2>
      <a class="more" href="/experience">Full strip <Icon name="arrow-right" size={14} /></a>
    </div>
    <ol class="tickets">
      {roles.slice(0, 3).map((r) => <Ticket role={r} />)}
    </ol>
  </section>

  <Counter />
</Base>
