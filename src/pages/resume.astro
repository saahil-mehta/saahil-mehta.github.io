---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Counter from "../components/Counter.astro";
import { profile } from "../lib/profile";
import { pageTitle, breadcrumbJsonLd } from "../lib/seo";

const meta = profile.site.pages.resume;
const path = "/resume";
const pdf = "/Saahil-Mehta-Resume.pdf";
---

<Base title={pageTitle(meta.title)} description={meta.description} path={path} jsonLd={[breadcrumbJsonLd(meta.title, path)]}>
  <section class="box sheet container">
    <div class="page-head">
      <div>
        <h1>Resume</h1>
        <p>
          The full, printer-friendly history. The same facts are exported as <a href="/cv.md">Markdown</a> and <a href="/resume.json">JSON Resume</a>.
        </p>
      </div>
      <div class="actions">
        <a href={pdf} target="_blank" rel="noopener" class="btn fill"><Icon name="file" size={16} /><span>Open PDF</span></a>
        <a href={pdf} download class="btn"><Icon name="download" size={16} /><span>Download</span></a>
      </div>
    </div>
    <div class="resume-frame">
      <iframe src={`${pdf}#view=FitH`} title="Saahil Mehta resume PDF" loading="lazy"></iframe>
    </div>
  </section>
  <Counter />
</Base>
