---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Beat from "../components/Beat.astro";
import EndCard from "../components/EndCard.astro";
import { profile } from "../lib/profile";
import { pageTitle, breadcrumbJsonLd } from "../lib/seo";

const { site, person } = profile;
const meta = site.pages.resume;
---

<Base title={pageTitle(meta.title)} description={meta.description} path="/resume" jsonLd={[breadcrumbJsonLd(meta.title, "/resume")]}>
  <Beat id="resume" title="Resume" lede="The two-page version, as a PDF. The same record is available as JSON and Markdown at the foot of the page." level={1}>
    <div class="controls" style="display:flex; flex-wrap:wrap; gap:0.75rem 1.5rem; margin-bottom:2rem" data-arrive="fade">
      <a class="btn fill" href="/Saahil-Mehta-Resume.pdf" download style="--i:0"><Icon name="download" size={16} /> Download PDF</a>
      <a class="btn ghost" href={person.links.calendly} target="_blank" rel="noopener" style="--i:1">Book a call <Icon name="arrow-right" size={16} class="arrow" /></a>
    </div>
    <iframe class="resume-frame" src="/Saahil-Mehta-Resume.pdf#view=FitH" title={`${person.name} resume`} loading="lazy"></iframe>
    <ol class="resume-pages" aria-label="Resume pages">
      {[1, 2].map((n) => (
        <li>
          <a href="/Saahil-Mehta-Resume.pdf"><img src={`/resume/page-${n}.webp`} width="900" height="1274" alt={`${person.name} resume, page ${n} of 2`} loading={n === 1 ? "eager" : "lazy"} decoding="async" /></a>
        </li>
      ))}
    </ol>
  </Beat>
  <EndCard />
</Base>
