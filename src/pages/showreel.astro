---
// The showreel: Orca and the platform under it, one scene per screen. The chapter bar at the
// foot of the window names the scene in view and jumps between them. All copy and figures come
// from site.showreel in profile.yaml; the roadmap and the platform drawing are the generated
// diagrams the projects page uses.
import Base from "../layouts/Base.astro";
import Beat from "../components/Beat.astro";
import OrcaDemo from "../components/OrcaDemo.astro";
import ReelStory from "../components/ReelStory.astro";
import Diagram from "../components/Diagram.astro";
import EndCard from "../components/EndCard.astro";
import Icon from "../components/Icon.astro";
import { profile } from "../lib/profile";
import { fmtDay } from "../lib/dates";
import { pageTitle, breadcrumbJsonLd } from "../lib/seo";

const { site } = profile;
const reel = site.showreel;
const meta = site.pages.showreel;
if (!reel || !meta) throw new Error("site.showreel and site.pages.showreel are both needed for /showreel");
const { orca, platform } = reel;

const chapters = [
  { id: "orca", label: "Orca" },
  { id: "how", label: "How it works" },
  { id: "does", label: "What it does" },
  { id: "adoption", label: "Adoption" },
  { id: "lean", label: "Running cost" },
  { id: "platform", label: "The platform" },
  { id: "scale", label: "Scale" },
  { id: "savings", label: "Savings" },
  { id: "fits", label: "How it fits together" },
  ...(site.roadmap ? [{ id: "plan", label: "The plan" }] : []),
];
---

<Base title={pageTitle(meta.title)} description={meta.description} path="/showreel" jsonLd={[breadcrumbJsonLd(meta.title, "/showreel")]}>
  <section class="reel-open wrap" id="orca" aria-labelledby="orca-title">
    <div class="reel-open-copy" data-arrive>
      <span class="logo orca-mark big" style="--i:0;--logo:url(/logos/orca.png);--ar:1.049" role="img" aria-label="The Orca mark"></span>
      <h1 class="title" id="orca-title" style="--i:1">Orca</h1>
      <p class="lede" style="--i:2">{orca.line}</p>
      <p class="reel-meta" style="--i:3">{reel.lede} Figures as of {fmtDay(reel.as_of)}.</p>
    </div>
    <OrcaDemo />
  </section>

  <section class="beat wrap" id="how" aria-labelledby="how-title">
    <div class="beat-head" data-arrive>
      <h2 class="h2" id="how-title" style="--i:0">How it works</h2>
    </div>
    <figure class="reel-loop" data-arrive="loop">
      <ol>
        {
          orca.loop.map((s, i) => (
            <li style={`--i:${i}`}>
              <span class="loop-name">{s.name}</span>
              <span class="loop-line">{s.line}</span>
            </li>
          ))
        }
      </ol>
      <svg class="loop-return" viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true">
        <path d="M830 2 V24 Q830 34 820 34 H14 Q4 34 4 24 V8" pathLength="1" />
        <path class="loop-head" d="M-1 13 4 6 9 13" />
      </svg>
      <figcaption class="lede">{orca.loop_note}</figcaption>
    </figure>
  </section>

  <section class="beat wrap" id="does" aria-labelledby="does-title">
    <div class="beat-head" data-arrive>
      <h2 class="h2" id="does-title" style="--i:0">What it does</h2>
    </div>
    <dl class="reel-caps" data-arrive>
      {
        orca.capabilities.map((c, i) => (
          <div style={`--i:${i}`}>
            <dt class="h3">{c.name}</dt>
            <dd>{c.line}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <Beat id="adoption" title="Adoption">
    <div class="lines" data-arrive>
      {orca.adoption.map((line, i) => <p style={`--i:${i}`}>{line}</p>)}
    </div>
  </Beat>

  <Beat id="lean" title="Running cost and footprint">
    <ul class="reel-facts" data-arrive>
      {orca.lean.map((line, i) => <li style={`--i:${i}`}>{line}</li>)}
    </ul>
  </Beat>

  <Beat id="platform" title="The platform" lede={platform.line}>
    <ReelStory />
  </Beat>

  <Beat id="scale" title="Scale">
    <ul class="reel-facts" data-arrive>
      {platform.scale.map((line, i) => <li style={`--i:${i}`}>{line}</li>)}
    </ul>
  </Beat>

  <Beat id="savings" title="Savings">
    <ol class="credits reel-money">
      {
        platform.money.map((m) => (
          <li class="credit-row" data-arrive>
            <span class="when credit" style="--i:0">{m.state}</span>
            <div class="what" style="--i:1">
              <h3 class="h3">{m.stopped}</h3>
              <p class="org">
                <Icon name="arrow-right" size={14} class="swap" />
                {m.instead}
              </p>
              <p class="amount">{m.amount}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="lines reel-close" data-arrive><span style="--i:0">{platform.money_note}</span></p>
  </Beat>

  {
    site.ecosystem && (
      <Beat id="fits" title="How it fits together" lede={site.narrative.ledes.platform}>
        <Diagram kind="platform" note={site.ecosystem.note} />
      </Beat>
    )
  }

  {
    site.roadmap && (
      <Beat id="plan" title="The plan" lede={site.narrative.ledes.plan}>
        <Diagram kind="roadmap" />
      </Beat>
    )
  }

  <EndCard />

  <nav class="reel-bar" aria-label="Showreel chapters">
    <div class="wrap">
      <span class="reel-now credit"><span class="reel-n num">1</span>/{chapters.length} <span class="reel-label">{chapters[0].label}</span></span>
      <ol class="reel-ticks">
        {
          chapters.map((c) => (
            <li>
              <a href={`#${c.id}`} data-tick={c.id}>
                <span class="sr-only">{c.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </nav>
</Base>
